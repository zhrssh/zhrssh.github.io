---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import MainLayout from "../../layouts/MainLayout.astro";
import Section from "../../components/Section.astro";
import { getReadingTime } from "../../utils/readingTime";
import { SITE_CONFIG } from "../../config";

export async function getStaticPaths() {
  const projectEntries = await getCollection("projects");
  return projectEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<"projects"> };
const { entry } = Astro.props;
const { Content } = await render(entry);
const readingTime = getReadingTime(entry.body || "");

const projectsByDate = (await getCollection("projects")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const currentIndex = projectsByDate.findIndex((p) => p.id === entry.id);
const olderProject = currentIndex < projectsByDate.length - 1 ? projectsByDate[currentIndex + 1] : null;
const newerProject = currentIndex > 0 ? projectsByDate[currentIndex - 1] : null;

const BUTTONS = [
  { key: "demo", label: "Live demo" },
  { key: "video", label: "Watch demo" },
  { key: "caseStudy", label: "Read case study" },
  { key: "link", label: "View project" },
  { key: "github", label: "Source" },
] as const;

type ProjectButton = { href: string; label: string; external: boolean };

const buttons: ProjectButton[] = BUTTONS.filter(({ key }) => entry.data[key]).map(({ key, label }) => {
  const href = entry.data[key] as string;
  return { href, label, external: href.startsWith("http") };
});

if (entry.data.bookCall) {
  buttons.push({
    href: SITE_CONFIG.bookingUrl,
    label: "Book a call",
    external: SITE_CONFIG.bookingUrl.startsWith("http"),
  });
}
---

<MainLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.coverImage?.src}
>
  <div class="container">
  <article class="post">
    <header class="post-header">
      <span class="eyebrow">Project</span>
      <div class="post-meta">
        <time datetime={entry.data.date.toISOString()}>
          {entry.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
        <span class="meta-dot">•</span>
        <span>{readingTime} min read</span>
      </div>
      <h1>{entry.data.title}</h1>
      <hr class="accent-rule" />
      {entry.data.impact && <p class="post-impact">{entry.data.impact}</p>}
      <p class="post-description">{entry.data.description}</p>
      <div class="post-tags">
        {entry.data.tags.map(tag => <span>{tag}</span>)}
      </div>
      {buttons.length > 0 && (
        <div class="post-buttons">
          {buttons.map((btn, i) => (
            <a
              href={btn.href}
              class={i === 0 ? "button" : "button button-secondary"}
              target={btn.external ? "_blank" : undefined}
              rel={btn.external ? "noopener noreferrer" : undefined}
            >
              {btn.label}
            </a>
          ))}
        </div>
      )}
    </header>

    {entry.data.coverImage && (
      <div class="post-cover">
        <Image src={entry.data.coverImage} alt={entry.data.title} width={1440} height={810} widths={[480, 720, 1080, 1440]} sizes="(max-width: 768px) 100vw, 680px" quality={90} />
      </div>
    )}

    <div class="post-content">
      <Content />
    </div>

    <nav class="post-adjacent" aria-label="More projects">
      {olderProject ? (
        <a href={`/projects/${olderProject.id}`} class="adjacent-link adjacent-prev">
          <span class="adjacent-label">&larr; Previous</span>
          <span class="adjacent-title">{olderProject.data.title}</span>
        </a>
      ) : <span class="adjacent-link adjacent-placeholder" aria-hidden="true" />}
      {newerProject ? (
        <a href={`/projects/${newerProject.id}`} class="adjacent-link adjacent-next">
          <span class="adjacent-label">Next &rarr;</span>
          <span class="adjacent-title">{newerProject.data.title}</span>
        </a>
      ) : <span class="adjacent-link adjacent-placeholder" aria-hidden="true" />}
    </nav>
  </article>
  </div>

  <Section surface="inverse" class="post-cta-section">
    <h2>Let's Fix What's Slowing You Down</h2>
    <p>Tell me what's eating your time — I'll reply within a day or two with how I'd automate it.</p>
    <a href={SITE_CONFIG.bookingUrl} class="button button-accent">Book a call</a>
  </Section>

  <style>
    .post {
      max-width: var(--max-width);
      margin: 0 auto;
    }

    .post-header {
      margin-bottom: var(--space-2xl);
    }

    .post-meta {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      font-size: var(--text-xs);
      color: var(--text-muted);
      margin-bottom: var(--space-md);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .meta-dot {
      color: var(--border);
    }

    .post-header h1 {
      font-size: var(--text-4xl);
      margin: 0 0 0;
      line-height: 1.2;
      color: var(--text-primary);
    }

    .post-impact {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      font-weight: 500;
      color: var(--accent);
      line-height: 1.3;
      letter-spacing: -0.005em;
      margin: 0 0 var(--space-md);
      text-wrap: pretty;
    }

    .post-description {
      font-size: var(--text-lg);
      color: var(--text-secondary);
      line-height: 1.6;
      margin: 0 0 var(--space-lg);
    }

    .post-tags {
      display: flex;
      gap: var(--space-sm);
      flex-wrap: wrap;
      margin-bottom: var(--space-lg);
    }

    .post-tags span {
      font-size: var(--text-xs);
      padding: 0.125rem 0.5rem;
      border: 1px solid var(--border);
      border-radius: var(--border-radius);
      color: var(--text-secondary);
      font-weight: 500;
      background-color: transparent;
    }

    .post-buttons {
      display: flex;
      gap: var(--space-sm);
      flex-wrap: wrap;
    }

    .post-cover {
      margin-bottom: var(--space-2xl);
      border: 1px solid var(--border);
      border-radius: var(--border-radius);
      overflow: hidden;
    }

    .post-cover :global(img) {
      width: 100%;
      height: auto;
      display: block;
    }

    .post-content {
      font-size: var(--text-base);
      line-height: 1.8;
      max-width: var(--max-width);
    }

    .post-content :global(h2) {
      font-size: var(--text-2xl);
      margin-top: var(--space-2xl);
      margin-bottom: var(--space-md);
    }

    .post-content :global(h3) {
      font-size: var(--text-xl);
      margin-top: var(--space-xl);
      margin-bottom: var(--space-md);
    }

    .post-content :global(p) {
      margin-bottom: var(--space-lg);
      color: var(--text-secondary);
    }

    .post-content :global(a) {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .post-content :global(a:hover) {
      color: var(--accent-hover);
    }

    .post-content :global(ul),
    .post-content :global(ol) {
      margin-bottom: var(--space-lg);
      padding-left: var(--space-xl);
      color: var(--text-secondary);
    }

    .post-content :global(li) {
      margin-bottom: var(--space-sm);
    }

    .post-content :global(blockquote) {
      margin: var(--space-xl) 0;
      padding: var(--space-md) var(--space-xl);
      background-color: var(--bg-secondary);
      border-radius: var(--border-radius);
      font-style: italic;
      color: var(--text-secondary);
    }

    .post-content :global(code) {
      font-family: var(--font-mono);
      font-size: 0.9em;
      padding: 0.15em 0.35em;
      background-color: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: var(--border-radius);
    }

    .post-content :global(pre) {
      margin: var(--space-xl) 0;
      padding: var(--space-lg);
      background-color: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: var(--border-radius);
      overflow-x: auto;
    }

    .post-content :global(pre code) {
      padding: 0;
      background: none;
      border: none;
      font-size: var(--text-sm);
    }

    .post-content :global(img) {
      max-width: 100%;
      height: auto;
      border-radius: var(--border-radius);
      margin: var(--space-xl) 0;
    }

    .post-adjacent {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
      margin-top: var(--space-2xl);
      padding-top: var(--space-xl);
      border-top: 1px solid var(--border);
    }

    .adjacent-link {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
      text-decoration: none;
      color: inherit;
      padding: var(--space-md);
      border: 1px solid var(--border);
      border-radius: var(--border-radius-lg);
      transition: border-color var(--transition-fast);
    }

    .adjacent-link:hover {
      border-color: var(--accent);
    }

    .adjacent-next {
      text-align: right;
      align-items: flex-end;
      grid-column: 2;
    }

    .adjacent-placeholder {
      border: none;
    }

    .adjacent-label {
      font-size: var(--text-xs);
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .adjacent-title {
      color: var(--text-primary);
      font-weight: 500;
      transition: color var(--transition-fast);
    }

    .adjacent-link:hover .adjacent-title {
      color: var(--accent);
    }

    @media (max-width: 768px) {
      .post-header h1 {
        font-size: var(--text-3xl);
      }

      .post-meta {
        flex-wrap: wrap;
      }

      .post-adjacent {
        grid-template-columns: 1fr;
      }

      .adjacent-next {
        grid-column: 1;
        text-align: left;
        align-items: flex-start;
      }
    }

    .post-cta-section :global(.container) {
      text-align: center;
    }

    .post-cta-section :global(h2) {
      margin: 0 0 var(--space-md);
    }

    .post-cta-section :global(p) {
      font-size: var(--text-lg);
      max-width: 540px;
      margin: 0 auto var(--space-xl);
      line-height: 1.6;
      opacity: 0.85;
    }
  </style>
</MainLayout>
