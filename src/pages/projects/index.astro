---
import MainLayout from "../../layouts/MainLayout.astro";
import Section from "../../components/Section.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getCollection } from "astro:content";

const allProjects = (await getCollection("projects", ({ data }) => !data.archived)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<MainLayout
  title="Projects: Custom Internal Systems in Use"
  description="Real internal systems built for real clients, and what changed for the people using them.">
  <Section class="page-header-section">
    <div class="page-header">
      <h1>Projects</h1>
      <hr class="rule" />
      <p class="page-description">
        Only real work for real clients. No demos. Each one starts with what the team was stuck doing by hand, and what changed once the system took over.
      </p>
    </div>
  </Section>

  <div class="container">
    <ul class="project-list" id="projects-list">
      {
        allProjects.map((project) => (
          <li class="project-item">
            <ProjectCard
              project={project}
              variant="featured"
              showMeta
              headingLevel={2}
            />
          </li>
        ))
      }
    </ul>
  </div>

  <CtaBand title="Could your team use one of these?">
    In a free 45-minute call we'll work out whether a custom system is worth
    it for you. Sometimes the honest answer is no.
  </CtaBand>

  <style>
    .page-header h1 {
      margin: 0 0 0;
    }

    .page-description {
      color: var(--text-secondary);
      font-size: var(--text-lg);
      margin: 0;
    }

    .project-list {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
      list-style: none;
      padding: 0;
      margin: 0 0 var(--space-3xl);
    }

    .project-item {
      display: flex;
    }
  </style>
</MainLayout>
