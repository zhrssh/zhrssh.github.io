---
import MainLayout from "../../layouts/MainLayout.astro";
import Section from "../../components/Section.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";

const allProjects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const allTags = [...new Set(allProjects.flatMap((p) => p.data.tags))].sort();
const featuredId = (allProjects.find((p) => p.data.featured) ?? allProjects[0])
  ?.id;
---

<MainLayout
  title="AI Automation Projects & Case Studies"
  description="Case studies in AI automation, workflow engineering, and business system integration — real projects with measurable results.">
  <Section class="page-header-section">
    <div class="page-header">
      <span class="eyebrow">Work</span>
      <h1>Projects</h1>
      <hr class="rule" />
      <p class="page-description">
        A collection of things I've built and experimented with.
      </p>
    </div>
  </Section>

  <div class="container">
    <section class="controls">
      <div class="search-wrapper">
        <Icon name="search" size={18} class="search-icon" />
        <input type="text" id="search-input" placeholder="Search projects..." />
      </div>
      <select id="tag-filter">
        <option value="all">All Tags</option>
        {allTags.map((tag) => <option value={tag}>{tag}</option>)}
      </select>
      <select id="sort-select">
        <option value="newest">Newest First</option>
        <option value="oldest">Oldest First</option>
        <option value="title">Alphabetical</option>
      </select>
    </section>

    <ul class="project-list" id="projects-list">
      {
        allProjects.map((project) => (
          <li
            class:list={[
              "project-item",
              project.id === featuredId && "project-item-featured",
            ]}
            data-featured={project.id === featuredId}
            data-tags={project.data.tags.join("|")}
            data-title={project.data.title}
            data-description={project.data.description}
            data-date={project.data.date.getTime()}>
            <ProjectCard
              project={project}
              variant={project.id === featuredId ? "featured" : "compact"}
              showMeta
            />
          </li>
        ))
      }
    </ul>

    <div class="empty-state" id="empty-state" hidden>
      <p>No projects match your filters.</p>
      <button type="button" id="clear-filters" class="button button-secondary"
        >Clear filters</button
      >
    </div>
  </div>

  <style>
    .page-header h1 {
      margin: 0 0 0;
    }

    .page-description {
      color: var(--text-secondary);
      font-size: var(--text-lg);
      margin: 0;
    }

    .controls {
      margin-bottom: var(--space-2xl);
      display: flex;
      gap: var(--space-md);
      flex-wrap: wrap;
      padding: var(--space-md) var(--space-lg);
      background-color: var(--surface-raised);
      border-radius: var(--border-radius);
    }

    .search-wrapper {
      position: relative;
      flex: 1;
      min-width: 200px;
    }

    .search-wrapper :global(.search-icon) {
      position: absolute;
      left: var(--space-md);
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      pointer-events: none;
    }

    input,
    select {
      padding: 0.375rem var(--space-md);
      border: 1px solid var(--border);
      border-radius: var(--border-radius);
      background-color: var(--bg);
      color: var(--text-primary);
      font-size: var(--text-sm);
      transition: border-color var(--transition-fast);
      width: 100%;
    }

    .search-wrapper input {
      padding-left: 2.75rem;
    }

    input:focus,
    select:focus {
      outline: none;
      border-color: var(--accent);
    }

    select {
      cursor: pointer;
      min-width: 140px;
      width: auto;
    }

    .project-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: var(--space-xl);
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .project-item {
      display: flex;
    }

    .project-list[hidden] {
      display: none;
    }

    .empty-state {
      display: none;
      text-align: center;
      padding: var(--space-3xl) var(--space-xl);
      color: var(--text-muted);
    }

    .empty-state:not([hidden]) {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-lg);
    }

    .empty-state p {
      margin: 0;
      font-size: var(--text-lg);
    }

    /* Breakpoint must stay in sync with .project-card-featured's
       horizontal layout in src/components/ProjectCard.astro */
    @media (min-width: 1024px) {
      .project-item-featured {
        grid-column: 1 / -1;
      }
    }

    @media (min-width: 769px) {
      .controls {
        position: sticky;
        top: var(--header-height, 65px);
        z-index: 900;
      }
    }

    @media (max-width: 768px) {
      .project-list {
        grid-template-columns: 1fr;
      }

      .controls {
        flex-direction: column;
      }

      select {
        width: 100%;
      }
    }
  </style>

  <script>
    const searchInput = document.getElementById(
      "search-input",
    ) as HTMLInputElement;
    const tagFilter = document.getElementById(
      "tag-filter",
    ) as HTMLSelectElement;
    const sortSelect = document.getElementById(
      "sort-select",
    ) as HTMLSelectElement;
    const projectList = document.getElementById(
      "projects-list",
    ) as HTMLUListElement;
    const emptyState = document.getElementById("empty-state") as HTMLElement;
    const clearFiltersBtn = document.getElementById(
      "clear-filters",
    ) as HTMLButtonElement;
    const projectItems = Array.from(
      document.querySelectorAll(".project-item"),
    ) as HTMLElement[];

    function updateView() {
      const searchTerm = searchInput.value.trim().toLowerCase();
      const selectedTag = tagFilter.value;
      const sortBy = sortSelect.value;

      let filtered = projectItems.filter((item) => {
        const title = item.getAttribute("data-title")!.toLowerCase();
        const description = item
          .getAttribute("data-description")!
          .toLowerCase();
        const tags = item.getAttribute("data-tags")!.toLowerCase();
        const matchesSearch =
          !searchTerm ||
          title.includes(searchTerm) ||
          description.includes(searchTerm) ||
          tags.includes(searchTerm);
        const matchesTag =
          selectedTag === "all" ||
          item.getAttribute("data-tags")!.split("|").includes(selectedTag);
        return matchesSearch && matchesTag;
      });

      filtered.sort((a, b) => {
        if (sortBy === "newest")
          return (
            parseInt(b.getAttribute("data-date")!) -
            parseInt(a.getAttribute("data-date")!)
          );
        if (sortBy === "oldest")
          return (
            parseInt(a.getAttribute("data-date")!) -
            parseInt(b.getAttribute("data-date")!)
          );
        if (sortBy === "title")
          return a
            .getAttribute("data-title")!
            .localeCompare(b.getAttribute("data-title")!);
        return 0;
      });

      const isDefaultView =
        !searchTerm && selectedTag === "all" && sortBy === "newest";

      projectItems.forEach((item) => {
        const isFeatured = item.dataset.featured === "true";
        item.classList.toggle(
          "project-item-featured",
          isFeatured && isDefaultView,
        );
        item
          .querySelector(".project-card")
          ?.classList.toggle("project-card-featured", isFeatured && isDefaultView);
      });

      projectList.innerHTML = "";
      filtered.forEach((item) => projectList.appendChild(item));

      const hasResults = filtered.length > 0;
      projectList.hidden = !hasResults;
      emptyState.hidden = hasResults;
    }

    function updateHeaderHeightVar() {
      const header = document.querySelector(
        ".site-header",
      ) as HTMLElement | null;
      if (header) {
        document.documentElement.style.setProperty(
          "--header-height",
          `${header.offsetHeight}px`,
        );
      }
    }

    searchInput.addEventListener("input", updateView);
    tagFilter.addEventListener("change", updateView);
    sortSelect.addEventListener("change", updateView);
    clearFiltersBtn.addEventListener("click", () => {
      searchInput.value = "";
      tagFilter.value = "all";
      updateView();
    });

    updateHeaderHeightVar();
    window.addEventListener("resize", updateHeaderHeightVar);
  </script>
</MainLayout>
