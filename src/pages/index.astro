---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import me from "../assets/me.jpg";
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProofStrip from "../components/ProofStrip.astro";
import Section from "../components/Section.astro";
import { SITE_CONFIG } from "../config";
import MainLayout from "../layouts/MainLayout.astro";

const projects = await getCollection("projects");
const featuredProjects = projects
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 9);
const projectCols = Math.min(featuredProjects.length, 3);
---

<MainLayout
  title="AI Automation & n8n Workflows"
  description="Still doing repetitive tasks by hand? I build n8n automations and AI workflows that run them 24/7 — fewer errors, and hours back for your team every week.">
  <Section class="hero-section">
    <div class="hero">
      <div class="hero-content">
        <span class="eyebrow eyebrow-live">
          <span class="pulse-dot" aria-hidden="true"></span>
          Available for work
        </span>
        <h1>AI automation &amp; n8n workflows that give your team its week back.</h1>
        <hr class="accent-rule" />
        <p class="hero-tagline">
          I'm Zherish — I build AI-powered workflows for service businesses, so
          the manual bottlenecks stop costing you time and money.
        </p>
        <div class="hero-cta">
          <a href={SITE_CONFIG.bookingUrl} class="button">Book a call</a>
          <a href="/projects" class="button button-secondary">View my work</a>
          <a href={SITE_CONFIG.resumeUrl} class="hero-tertiary" download
            >Download CV →</a
          >
        </div>
      </div>
      <div class="hero-portrait">
        <div class="hero-img-frame">
          <Image
            src={me}
            alt="Zherish Galvin Mayordo"
            width={640}
            height={640}
            loading="eager"
          />
        </div>
      </div>
    </div>
  </Section>

  <Section surface="raised" eyebrow="Proof" title="Results, not promises">
    <ProofStrip projects={projects} />
  </Section>

  <Section eyebrow="What I offer" title="My Services">
    <div class="services-list">
      {
        SITE_CONFIG.services.map((service) => (
          <div class="service-row">
            <Icon name={service.icon} size={32} class="service-icon" />
            <div class="service-body">
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    surface="raised"
    eyebrow="How it works"
    title="How We'd Work Together"
    class="process-section">
    <div class="process-list">
      {
        SITE_CONFIG.process.map((step) => (
          <div class="process-row">
            <span class="process-number">{step.number}</span>
            <div class="process-body">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    eyebrow="Latest work"
    title="Projects"
    link={{ href: "/projects", label: "View all →" }}
    class="projects-section">
    <div class="projects-grid" data-cols={projectCols}>
      {
        featuredProjects.length > 0 ? (
          featuredProjects.map((project) => <ProjectCard project={project} />)
        ) : (
          <p class="empty-state">No projects yet. Check back soon!</p>
        )
      }
    </div>
  </Section>

  <Section surface="inverse" class="cta-section">
    <h2>Let's Fix What's Slowing You Down</h2>
    <p>
      Tell me what's eating your time — I'll reply within a day or two with how
      I'd automate it.
    </p>
    <a href={SITE_CONFIG.bookingUrl} class="button button-accent"
      >Get in Touch</a
    >
  </Section>

  <style>
    .hero {
      display: flex;
      gap: var(--space-2xl);
      align-items: center;
      justify-content: space-between;
    }

    .hero-content {
      max-width: 720px;
      text-align: left;
    }

    .eyebrow-live {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
    }

    .pulse-dot {
      position: relative;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: var(--accent);
      flex-shrink: 0;
    }

    .pulse-dot::after {
      content: "";
      position: absolute;
      inset: -5px;
      border-radius: 50%;
      background-color: var(--accent);
      opacity: 0.5;
      animation: pulse-ring 2s ease-out infinite;
    }

    @keyframes pulse-ring {
      0% {
        transform: scale(0.6);
        opacity: 0.5;
      }
      100% {
        transform: scale(1.8);
        opacity: 0;
      }
    }

    .hero-portrait {
      position: relative;
      flex-shrink: 0;
      padding: var(--space-md);
      margin: calc(-1 * var(--space-md));
    }

    .hero-portrait::before {
      content: "";
      position: absolute;
      top: calc(var(--space-md) + 12px);
      left: calc(var(--space-md) + 12px);
      width: clamp(220px, 24vw, 320px);
      height: clamp(220px, 24vw, 320px);
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-top: 2px solid var(--accent);
      border-radius: var(--border-radius-lg);
      z-index: 0;
      transition: transform var(--transition-fast);
    }

    .hero-img-frame {
      width: clamp(220px, 24vw, 320px);
      height: clamp(220px, 24vw, 320px);
      border-radius: var(--border-radius-lg);
      overflow: hidden;
      border: 1px solid var(--border);
      border-top: 2px solid var(--accent);
      background: var(--bg);
      position: relative;
      z-index: 1;
      transition: transform var(--transition-fast);
    }

    .hero-portrait:hover .hero-img-frame {
      transform: translateY(-2px);
    }

    .hero-portrait:hover::before {
      transform: translate(2px, 2px);
    }

    .hero-img-frame :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hero h1 {
      max-width: 18ch;
      margin: 0 0 0;
    }

    .hero-tagline {
      font-size: var(--text-lg);
      color: var(--text-secondary);
      margin: 0 0 var(--space-xl);
      line-height: 1.6;
      max-width: 52ch;
    }

    .hero-cta {
      display: flex;
      gap: var(--space-md);
      align-items: center;
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    .hero-tertiary {
      color: var(--text-muted);
      font-size: var(--text-sm);
      text-decoration: none;
      transition: color var(--transition-fast);
    }

    .hero-tertiary:hover {
      color: var(--accent);
    }

    .services-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-lg);
    }

    .service-row {
      display: flex;
      gap: var(--space-lg);
      padding: var(--space-lg);
      border-radius: var(--border-radius-lg);
      border: 1px solid var(--border);
      border-top: 2px solid var(--accent);
      transition: border-color var(--transition-fast);
      background-color: var(--bg);
      align-items: flex-start;
    }

    .service-row:hover {
      border-color: var(--border-hover);
      border-top-color: var(--accent);
    }

    .service-row :global(.service-icon) {
      color: var(--accent);
      flex-shrink: 0;
    }

    .service-body h3 {
      margin: 0 0 var(--space-sm);
      font-size: var(--text-lg);
    }

    .service-body p {
      margin: 0;
      color: var(--text-secondary);
      font-size: var(--text-sm);
      line-height: 1.6;
    }

    .process-list {
      display: flex;
      flex-direction: column;
    }

    .process-row {
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      gap: var(--space-lg);
      align-items: start;
      padding-block: var(--space-xl);
      border-bottom: 1px solid var(--border);
    }

    .process-row:first-child {
      padding-top: 0;
    }

    .process-row:last-child {
      padding-bottom: 0;
      border-bottom: none;
    }

    .process-number {
      font-family: var(--font-mono);
      font-size: var(--text-2xl);
      font-weight: 600;
      color: var(--accent);
      line-height: 1.3;
    }

    .process-body h3 {
      margin: 0 0 var(--space-sm);
      font-size: var(--text-lg);
    }

    .process-body p {
      margin: 0;
      color: var(--text-secondary);
      font-size: var(--text-sm);
      line-height: 1.6;
      max-width: 60ch;
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-xl);
    }

    .projects-grid[data-cols="1"] {
      max-width: 640px;
      margin-inline: auto;
    }

    .empty-state {
      text-align: center;
      color: var(--text-muted);
      padding: var(--space-3xl);
      grid-column: 1 / -1;
    }

    .cta-section :global(.container) {
      text-align: center;
    }

    .cta-section :global(h2) {
      margin: 0 0 var(--space-md);
    }

    .cta-section :global(p) {
      font-size: var(--text-lg);
      max-width: 540px;
      margin: 0 auto var(--space-xl);
      line-height: 1.6;
      opacity: 0.85;
    }

    @media (max-width: 768px) {
      .hero {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-xl);
      }

      .hero-portrait {
        align-self: center;
      }

      .hero-portrait::before {
        top: calc(var(--space-md) + 8px);
        left: calc(var(--space-md) + 8px);
      }
    }
  </style>
</MainLayout>
