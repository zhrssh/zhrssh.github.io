---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import me from "../assets/me.jpg";
import caseOutput from "../assets/projects/propresenter-lyrics-formatter-2/output.png";
import ProjectCard from "../components/ProjectCard.astro";
import ProofStrip from "../components/ProofStrip.astro";
import Section from "../components/Section.astro";
import { SITE_CONFIG } from "../config";
import MainLayout from "../layouts/MainLayout.astro";

const CASE_STUDY_ID = "propresenter-lyrics-formatter-2";
const projects = await getCollection("projects", ({ data }) => !data.archived);
const featuredProjects = projects
  .filter((p) => p.data.featured && p.id !== CASE_STUDY_ID)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const projectCols = Math.min(featuredProjects.length, 3);
---

<MainLayout
  title="AI Automation & n8n Workflows"
  description="Still doing repetitive tasks by hand? I build n8n automations and AI workflows that run them 24/7 — fewer errors, and hours back for your team every week.">
  <Section class="hero-section">
    <div class="hero">
      <div class="hero-content">
        <div class="hero-status">
          <Image
            src={me}
            alt="Zherish Galvin Mayordo"
            width={112}
            height={112}
            loading="eager"
            class="hero-avatar"
          />
          <span class="status">
            <span class="pulse-dot" aria-hidden="true"></span>
            Available for work
          </span>
        </div>
        <h1>Hand off the busywork.<br />Get hours back every week.</h1>
        <hr class="accent-rule" />
        <p class="hero-tagline">
          I build n8n and AI workflows that take bookings, chase follow-ups and
          handle admin around the clock — so fewer leads slip through, fewer
          errors creep in, and your team gets back to serving clients.
        </p>
        <div class="hero-cta">
          <a href={SITE_CONFIG.bookingUrl} class="button" target="_blank" rel="noopener noreferrer">Book a call</a>
          <a href="/projects/" class="button button-secondary">View my work</a>
        </div>
        <p class="hero-credential">
          Computer Engineer · Co-author of two machine-learning papers, including IEEE TENCON 2024
        </p>
      </div>
      <div class="hero-portrait">
        <div class="hero-img-frame">
          <Image
            src={me}
            alt="Zherish Galvin Mayordo"
            width={640}
            height={640}
            loading="eager"
          />
        </div>
      </div>
    </div>
  </Section>

  <Section surface="raised" title="Results, not promises">
    <ProofStrip />
  </Section>

  <Section title="How a church team stopped hand-formatting lyrics">
    <p class="case-lead">
      Every week, Solace of Christ Church volunteers turn chord-chart PDFs into
      ProPresenter lyrics for Sunday service. I built them a dedicated tool that
      does the formatting for them.
    </p>
    <figure class="case-figure">
      <Image
        src={caseOutput}
        alt="Before and after: a chord-chart PDF with chord symbols above every line, and the same song as clean, ProPresenter-ready lyrics split into verses and chorus."
        widths={[800, 1200, 1695]}
        sizes="(max-width: 1200px) 100vw, 1136px"
      />
    </figure>
    <div class="case-compare">
      <div>
        <h3>Before</h3>
        <ol>
          <li>Open each chord-chart PDF and copy the lyrics out.</li>
          <li>Strip chord symbols and stray formatting by hand.</li>
          <li>Split verses and choruses, then reformat for ProPresenter.</li>
          <li>Repeat for every song, every week.</li>
        </ol>
      </div>
      <div>
        <h3>After</h3>
        <ol>
          <li>Paste the chord chart or upload the PDF on SCC's own access-gated page.</li>
          <li>An n8n workflow with a three-step AI chain groups, cleans and formats every song.</li>
          <li>Download ProPresenter-ready files, named per song, one by one or as a zip.</li>
        </ol>
      </div>
    </div>
    <p class="case-result">
      10+ minutes saved per song — hours back every month for the volunteer team.
    </p>
    <a href={`/projects/${CASE_STUDY_ID}/`} class="case-link">Read the full case study →</a>
  </Section>

  <Section
    surface="raised"
    title="Projects"
    link={{ href: "/projects/", label: "View all →" }}
    class="projects-section">
    <div class="projects-grid" data-cols={projectCols}>
      {
        featuredProjects.length > 0 ? (
          featuredProjects.map((project) => <ProjectCard project={project} />)
        ) : (
          <p class="empty-state">No projects yet. Check back soon!</p>
        )
      }
    </div>
  </Section>

  <Section surface="inverse" class="cta-section">
    <h2>Let's fix what's slowing you down</h2>
    <p>
      In a 45-minute discovery call, we'll find what's eating your team's time
      and how I'd automate it.
    </p>
    <a href={SITE_CONFIG.bookingUrl} class="button button-accent" target="_blank" rel="noopener noreferrer"
      >Book a call</a
    >
  </Section>

  <style>
    .hero {
      display: flex;
      gap: var(--space-2xl);
      align-items: center;
      justify-content: space-between;
    }

    .hero-content {
      max-width: 720px;
      text-align: left;
    }

    .hero-status {
      display: flex;
      align-items: center;
      gap: var(--space-md);
      margin-bottom: var(--space-sm);
    }

    .hero-status :global(.hero-avatar) {
      display: none;
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      font-size: var(--text-sm);
      color: var(--text-muted);
    }

    .pulse-dot {
      position: relative;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: var(--accent);
      flex-shrink: 0;
    }

    .pulse-dot::after {
      content: "";
      position: absolute;
      inset: -5px;
      border-radius: 50%;
      background-color: var(--accent);
      opacity: 0.5;
      animation: pulse-ring 2s ease-out infinite;
    }

    @keyframes pulse-ring {
      0% {
        transform: scale(0.6);
        opacity: 0.5;
      }
      100% {
        transform: scale(1.8);
        opacity: 0;
      }
    }

    .hero-portrait {
      position: relative;
      flex-shrink: 0;
    }

    .hero-img-frame {
      width: clamp(220px, 24vw, 320px);
      height: clamp(220px, 24vw, 320px);
      border-radius: var(--border-radius-lg);
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--bg);
      position: relative;
      z-index: 1;
      transition: transform var(--transition-fast);
    }

    .hero-portrait:hover .hero-img-frame {
      transform: translateY(-2px);
    }

    .hero-img-frame :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hero h1 {
      max-width: 22ch;
      margin: 0 0 0;
    }

    .hero-tagline {
      font-size: var(--text-lg);
      color: var(--text-secondary);
      margin: 0 0 var(--space-xl);
      line-height: 1.6;
      max-width: 52ch;
    }

    .hero-cta {
      display: flex;
      gap: var(--space-md);
      align-items: center;
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    .hero-credential {
      color: var(--text-muted);
      font-size: var(--text-sm);
      margin: var(--space-lg) 0 0;
    }

    .case-lead {
      font-size: var(--text-lg);
      color: var(--text-secondary);
      line-height: 1.6;
      max-width: 60ch;
      margin: 0 0 var(--space-2xl);
    }

    .case-figure {
      margin: 0 0 var(--space-2xl);
      border: 1px solid var(--border);
      border-radius: var(--border-radius-lg);
      overflow: hidden;
    }

    .case-figure img {
      display: block;
      width: 100%;
      height: auto;
    }

    .case-compare {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-2xl);
    }

    .case-compare h3 {
      font-size: var(--text-lg);
      margin: 0 0 var(--space-md);
    }

    .case-compare ol {
      display: grid;
      gap: var(--space-sm);
      margin: 0;
      padding-left: 1.25em;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .case-result {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      line-height: 1.35;
      max-width: 40ch;
      margin: var(--space-2xl) 0 var(--space-md);
      text-wrap: pretty;
    }

    .case-link {
      color: var(--accent);
      font-weight: 500;
      text-decoration: none;
      transition: color var(--transition-fast);
    }

    .case-link:hover {
      color: var(--accent-hover);
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-xl);
    }

    .projects-grid[data-cols="1"] {
      max-width: 640px;
      margin-inline: auto;
    }

    .empty-state {
      text-align: center;
      color: var(--text-muted);
      padding: var(--space-3xl);
      grid-column: 1 / -1;
    }

    @media (max-width: 768px) {
      .hero {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-xl);
      }

      .hero-portrait {
        display: none;
      }

      .hero-status :global(.hero-avatar) {
        display: block;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid var(--border);
      }
    }
  </style>
</MainLayout>
