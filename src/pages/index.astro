---
import { Image } from "astro:assets";
import me from "../assets/me.jpg";
import bridgeAlerts from "../assets/projects/tradingview-mt5-bridge/alerts-table.png";
import CtaBand from "../components/CtaBand.astro";
import Section from "../components/Section.astro";
import { SITE_CONFIG } from "../config";
import MainLayout from "../layouts/MainLayout.astro";
import { formatPrice } from "../lib/currency";

const { retainer } = SITE_CONFIG;
const usd = formatPrice(retainer.usd, "USD");
const php = formatPrice(retainer.php, "PHP");
---

<MainLayout
  title="Custom Internal Systems for Small Teams"
  description="I build the internal systems your team needs: automations, dashboards and tools for the work still done by hand. Handed over with docs and training, and yours to keep.">
  <Section class="hero-section">
    <div class="hero">
      <div class="hero-content">
        <div class="hero-status">
          <Image
            src={me}
            alt="Zherish Galvin Mayordo"
            width={112}
            height={112}
            loading="eager"
            class="hero-avatar"
          />
          <span class="status">
            <span class="pulse-dot" aria-hidden="true"></span>
            Available for work
          </span>
        </div>
        <h1>The work your team does by hand, handled.</h1>
        <hr class="accent-rule" />
        <p class="hero-tagline">
          I build custom automations, dashboards and admin tools around how your
          team already works.
        </p>
        <div class="hero-cta">
          <a href={SITE_CONFIG.bookingUrl} class="button" target="_blank" rel="noopener noreferrer"
            >Book a free discovery call<span class="sr-only"> (opens in a new tab)</span></a
          >
          <a href="#how-it-works" class="button button-secondary">See how it works</a>
        </div>
      </div>

      <div class="hero-portrait">
        <div class="hero-img-frame">
          <Image
            src={me}
            alt="Zherish Galvin Mayordo"
            width={640}
            height={640}
            loading="eager"
          />
        </div>
      </div>
    </div>

    <ul class="proof" aria-label="Results from real projects">
      <li>
        <a href="/projects/tradingview-mt5-bridge/" class="proof-link">
          <span class="proof-result">From one strategy per account to no cap</span>
          <span class="proof-who">Robin Ho's trading team</span>
        </a>
      </li>
      <li>
        <a href="/projects/propresenter-lyrics-formatter-2/" class="proof-link">
          <span class="proof-result">10+ minutes saved on every song</span>
          <span class="proof-who">Solace of Christ Church volunteers</span>
        </a>
      </li>
    </ul>
  </Section>

  <Section surface="raised" title="Where your team's week goes">
    <div class="swaps">
      <div class="swaps-head" aria-hidden="true">
        <span>Today</span>
        <span>Once it's built</span>
      </div>
      <ul>
        {
          SITE_CONFIG.problems.map((p) => (
            <li>
              <p class="swap-today">{p.today}</p>
              <p class="swap-fixed">
                <span class="sr-only">Once it's built: </span>
                {p.fixed}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section title="What it looks like" link={{ href: "/projects/", label: "All projects →" }}>
    <figure class="artifact">
      <a href="/projects/tradingview-mt5-bridge/" class="artifact-frame">
        <Image
          src={bridgeAlerts}
          alt="The bridge's dashboard: a log of strategy alerts, each with the MT5 trade it placed, whether it was executed or skipped, and how long it took."
          widths={[480, 800, 1152]}
          sizes="(max-width: 1264px) calc(100vw - 4rem), 1200px"
          loading="lazy"
        />
      </a>
      <figcaption>
        <p class="ledger-note">Robin Ho's trading team</p>
        <p>TradingView strategy alerts become MT5 trades, with as many strategies as one demo account can hold.</p>
        <a href="/projects/tradingview-mt5-bridge/" class="text-action">Read the story →</a>
      </figcaption>
    </figure>
  </Section>

  <Section id="how-it-works" surface="raised" title="How it works">
    <ol class="ledger">
      {
        SITE_CONFIG.engagement.map((step) => (
          <li class="ledger-row">
            <p class="ledger-note">{step.when}</p>
            <h3>{step.title}</h3>
            <p class="ledger-body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section class="handover-section">
    <div class="split">
      <div class="split-intro">
        <h2>What you get</h2>
        <p>Everything your team needs to run it, and to keep it running.</p>
      </div>
      <dl class="split-list">
        {
          SITE_CONFIG.handover.map((item) => (
            <div>
              <dt>{item.title}</dt>
              <dd>{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <ol class="ledger support">
      <li class="ledger-row">
        <p class="ledger-note">First month after handover</p>
        <h3>Free support</h3>
        <p class="ledger-body">
          If something doesn't work as agreed, I fix it. New features are quoted
          separately.
        </p>
      </li>
      <li class="ledger-row">
        <p class="ledger-note">After your free month, optional</p>
        <h3>Monthly retainer</h3>
        <div class="ledger-body" data-retainer data-usd={usd} data-php={php}>
          <div class="price-row">
            <p class="price">
              <span data-price aria-live="polite">From {usd}</span>
              <span class="price-per">/ month</span>
            </p>
            <div class="currency-switch" role="group" aria-label="Show price in" data-currency-switch hidden>
              <button type="button" data-currency="PHP" aria-pressed="false">₱ PHP</button>
              <button type="button" data-currency="USD" aria-pressed="true">$ USD</button>
            </div>
          </div>
          <noscript>
            <p class="price-alt">Clients in the Philippines: from {php} / month.</p>
          </noscript>
          <ul class="ledger-list">
            <li>Monitoring, so I hear about failures first</li>
            <li>Fixes when something breaks</li>
            <li>Up to {retainer.changeHours} hours of small changes a month, no rollover</li>
          </ul>
        </div>
      </li>
    </ol>
  </Section>

  <Section surface="raised" title="Questions people ask">
    <div class="faq">
      {
        SITE_CONFIG.faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </Section>

  <CtaBand title="Tell me what your team is still doing by hand">
    Free, 45 minutes. You'll know if it's worth it, even if the answer is no.
  </CtaBand>

  <script>
    import { pickCurrency, type Currency } from "../lib/currency";

    const box = document.querySelector<HTMLElement>("[data-retainer]");
    const amount = box?.querySelector<HTMLElement>("[data-price]");
    const currencySwitch = box?.querySelector<HTMLElement>("[data-currency-switch]");

    if (box && amount && currencySwitch) {
      const KEY = "currency";
      const buttons = currencySwitch.querySelectorAll<HTMLButtonElement>("button");
      let saved: string | null = null;
      try {
        saved = localStorage.getItem(KEY);
      } catch {}

      const show = (c: Currency) => {
        amount.textContent = `From ${c === "USD" ? box.dataset.usd : box.dataset.php}`;
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.currency === c)));
      };

      show(pickCurrency(saved, Intl.DateTimeFormat().resolvedOptions().timeZone));
      currencySwitch.hidden = false;
      buttons.forEach((b) =>
        b.addEventListener("click", () => {
          const next = b.dataset.currency as Currency;
          show(next);
          try {
            localStorage.setItem(KEY, next);
          } catch {}
        }),
      );
    }
  </script>

  <style>
    .hero {
      display: flex;
      gap: var(--space-2xl);
      align-items: center;
      justify-content: space-between;
    }

    .hero-content {
      max-width: 720px;
      text-align: left;
    }

    .hero-status {
      display: flex;
      align-items: center;
      gap: var(--space-md);
      margin-bottom: var(--space-sm);
    }

    .hero-status :global(.hero-avatar) {
      display: none;
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      font-size: var(--text-sm);
      color: var(--text-muted);
    }

    .pulse-dot {
      position: relative;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: var(--accent);
      flex-shrink: 0;
    }

    .pulse-dot::after {
      content: "";
      position: absolute;
      inset: -5px;
      border-radius: 50%;
      background-color: var(--accent);
      opacity: 0.5;
      animation: pulse-ring 2s ease-out infinite;
    }

    @keyframes pulse-ring {
      0% {
        transform: scale(0.6);
        opacity: 0.5;
      }
      100% {
        transform: scale(1.8);
        opacity: 0;
      }
    }

    .hero-portrait {
      position: relative;
      flex-shrink: 0;
    }

    .hero-img-frame {
      width: clamp(220px, 24vw, 320px);
      height: clamp(220px, 24vw, 320px);
      border-radius: var(--border-radius-lg);
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--bg);
    }

    .hero-img-frame :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hero h1 {
      max-width: 22ch;
      margin: 0;
    }

    .hero-tagline {
      font-size: var(--text-lg);
      color: var(--text-secondary);
      margin: 0 0 var(--space-xl);
      line-height: 1.6;
      max-width: 52ch;
    }

    .hero-cta {
      display: flex;
      gap: var(--space-md);
      align-items: center;
      flex-wrap: wrap;
    }


    /* Proof strip: two ruled results under the hero */
    .proof {
      list-style: none;
      margin: var(--space-3xl) 0 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-top: 1px solid var(--border);
    }

    .proof li {
      padding: var(--space-lg) var(--space-xl) 0 0;
    }

    .proof li + li {
      padding-left: var(--space-xl);
      border-left: 1px solid var(--border);
    }

    /* The whole result is the link: one big target */
    .proof-link {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
      color: inherit;
      text-decoration: none;
    }

    .proof-result {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      line-height: 1.3;
      color: var(--text-primary);
      transition: color var(--transition-fast);
    }

    .proof-who {
      color: var(--text-muted);
      font-size: var(--text-sm);
    }

    .proof-who::after {
      content: " →";
      color: var(--accent);
    }

    .proof-link:hover .proof-result {
      color: var(--accent);
    }

    .proof-link:hover .proof-who {
      text-decoration: underline;
      text-underline-offset: 0.2em;
      text-decoration-thickness: 1px;
    }


    /* Today → once it's built */
    .swaps ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .swaps-head,
    .swaps li {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-2xl);
    }

    .swaps-head {
      padding-bottom: var(--space-sm);
      border-bottom: 1px solid var(--border);
      font-family: var(--font-display);
      font-style: italic;
      font-size: var(--text-lg);
      color: var(--accent);
    }

    .swaps li {
      padding-block: var(--space-lg);
      border-bottom: 1px solid var(--border);
    }

    .swaps p {
      margin: 0;
      line-height: 1.6;
      max-width: 46ch;
    }

    .swap-today {
      color: var(--text-secondary);
    }

    .swap-fixed {
      font-weight: 500;
    }

    /* Ledger rows: margin note, title, detail */
    .ledger {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--border);
    }

    /* Straight under a section title, the title's rule is the top rule */
    :global(.section-header) + .ledger,
    :global(.section-header) + .faq {
      border-top: 0;
      margin-top: calc(-1 * var(--space-xl));
    }

    .ledger-row {
      display: grid;
      grid-template-columns: minmax(9rem, 1fr) minmax(0, 1.4fr) minmax(0, 2.4fr);
      gap: var(--space-xl);
      padding-block: var(--space-xl);
      border-bottom: 1px solid var(--border);
    }

    .ledger-note {
      font-family: var(--font-display);
      font-style: italic;
      font-size: var(--text-lg);
      line-height: 1.35;
      color: var(--accent);
      margin: 0;
    }

    .ledger-row h3 {
      font-size: var(--text-xl);
      margin: 0;
    }

    .ledger-body,
    .ledger-body p {
      color: var(--text-secondary);
      line-height: 1.6;
      margin: 0;
      max-width: 58ch;
    }

    .price-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-sm) var(--space-lg);
      margin: var(--space-sm) 0 var(--space-lg);
    }

    .ledger-body .price {
      display: flex;
      align-items: baseline;
      gap: var(--space-sm);
      margin: 0;
    }

    .price [data-price] {
      font-size: var(--text-xl);
      font-weight: 600;
      color: var(--text-primary);
      font-variant-numeric: tabular-nums;
    }

    .price-per {
      color: var(--text-muted);
    }

    .ledger-body .price-alt {
      margin-bottom: var(--space-md);
    }

    /* Two-option currency switch, 44px tall for thumbs */
    .currency-switch {
      display: inline-flex;
      border: 1px solid var(--border);
      border-radius: var(--border-radius);
      overflow: hidden;
    }

    .currency-switch button {
      font: inherit;
      font-size: var(--text-sm);
      font-weight: 500;
      min-height: 2.75rem;
      padding: 0 var(--space-md);
      color: var(--text-secondary);
      background: none;
      border: 0;
      cursor: pointer;
      font-variant-numeric: tabular-nums;
      transition: color var(--transition-fast), background-color var(--transition-fast);
    }

    .currency-switch button + button {
      border-left: 1px solid var(--border);
    }

    .currency-switch button:hover {
      color: var(--accent);
    }

    .currency-switch button[aria-pressed="true"] {
      background-color: var(--text-primary);
      color: var(--bg);
    }

    .currency-switch button:focus-visible {
      outline-offset: -4px;
    }

    .ledger-list {
      display: grid;
      gap: var(--space-xs);
      margin: 0;
      padding-left: 1.1em;
      color: var(--text-primary);
    }

    .ledger-list li::marker {
      color: var(--accent);
    }


    /* Handover: statement beside a ruled list */
    .split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--space-3xl);
      align-items: start;
    }

    .split-intro h2 {
      font-size: var(--text-3xl);
      margin: 0 0 var(--space-lg);
      max-width: 16ch;
    }

    .split-intro p {
      color: var(--text-secondary);
      font-size: var(--text-lg);
      line-height: 1.6;
      max-width: 40ch;
      margin: 0;
    }

    .support {
      margin-top: var(--space-3xl);
    }

    .split-list {
      margin: 0;
      border-top: 1px solid var(--border);
    }

    .split-list > div {
      padding-block: var(--space-lg);
      border-bottom: 1px solid var(--border);
    }

    .split-list dt {
      font-weight: 600;
      margin-bottom: var(--space-xs);
    }

    .split-list dd {
      margin: 0;
      color: var(--text-secondary);
      line-height: 1.6;
      max-width: 58ch;
    }

    /* What it looks like: one real screenshot, framed like a record */
    .artifact {
      display: grid;
      grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr);
      gap: var(--space-2xl);
      align-items: end;
      margin: 0;
    }

    .artifact-frame {
      display: block;
      border: 1px solid var(--border);
      border-radius: var(--border-radius-lg);
      overflow: hidden;
      background-color: var(--bg);
    }

    .artifact-frame :global(img) {
      display: block;
      width: 100%;
      height: auto;
    }

    .artifact figcaption p {
      color: var(--text-secondary);
      line-height: 1.6;
      margin: 0 0 var(--space-lg);
      max-width: 40ch;
    }

    .artifact figcaption .ledger-note {
      color: var(--accent);
      margin-bottom: var(--space-sm);
    }

    .text-action {
      font-weight: 500;
      text-decoration: none;
    }

    .text-action:hover {
      color: var(--accent-hover);
      text-decoration: underline;
      text-underline-offset: 0.2em;
      text-decoration-thickness: 1px;
    }

    /* FAQ: ruled, native disclosure */
    .faq {
      border-top: 1px solid var(--border);
      max-width: 820px;
    }

    .faq details {
      border-bottom: 1px solid var(--border);
    }

    .faq summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-lg);
      padding-block: var(--space-lg);
      font-weight: 600;
      font-size: var(--text-lg);
      cursor: pointer;
      list-style: none;
    }

    .faq summary::-webkit-details-marker {
      display: none;
    }

    /* Drawn chevron, turns on open */
    .faq summary::after {
      content: "";
      flex-shrink: 0;
      width: 0.55em;
      height: 0.55em;
      border-right: 1.5px solid var(--accent);
      border-bottom: 1.5px solid var(--accent);
      transform: translateY(-25%) rotate(45deg);
      transition: transform var(--transition);
    }

    .faq details[open] summary::after {
      transform: translateY(25%) rotate(-135deg);
    }

    .faq summary:hover {
      color: var(--accent);
    }

    .faq details p {
      margin: 0 0 var(--space-lg);
      color: var(--text-secondary);
      line-height: 1.6;
      max-width: 62ch;
    }

    @media (max-width: 900px) {
      .ledger-row {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-sm);
      }

      .split,
      .artifact {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-xl);
      }
    }

    @media (max-width: 768px) {
      .hero {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-xl);
      }

      .hero-portrait {
        display: none;
      }

      .hero-status :global(.hero-avatar) {
        display: block;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid var(--border);
      }

      .proof {
        grid-template-columns: minmax(0, 1fr);
        margin-top: var(--space-xl);
      }

      .proof li,
      .proof li + li {
        padding: var(--space-md) 0;
        border-left: 0;
      }

      .proof li + li {
        border-top: 1px solid var(--border);
      }

      .swaps-head {
        display: none;
      }

      .swaps li {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-sm);
      }

      .swaps li:first-child {
        border-top: 1px solid var(--border);
      }

      .swap-fixed::before {
        content: "Once it's built: ";
        font-family: var(--font-display);
        font-style: italic;
        font-weight: 400;
        color: var(--accent);
      }

      .swap-fixed .sr-only {
        display: none;
      }
    }
  </style>
</MainLayout>
