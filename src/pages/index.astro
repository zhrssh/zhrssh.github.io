---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import me from "../assets/me.jpg";
import Section from "../components/Section.astro";
import { SITE_CONFIG } from "../config";
import MainLayout from "../layouts/MainLayout.astro";
import { formatPrice } from "../lib/currency";

const projects = (await getCollection("projects", ({ data }) => !data.archived))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const { retainer } = SITE_CONFIG;
const usd = formatPrice(retainer.usd, "USD");
const php = formatPrice(retainer.php, "PHP");
---

<MainLayout
  title="Custom Internal Systems for Small Teams"
  description="I build the internal systems your team needs: automations, dashboards and tools for the work still done by hand. Handed over with docs and training, and yours to keep.">
  <Section class="hero-section">
    <div class="hero">
      <div class="hero-content">
        <div class="hero-status">
          <Image
            src={me}
            alt="Zherish Galvin Mayordo"
            width={112}
            height={112}
            loading="eager"
            class="hero-avatar"
          />
          <span class="status">
            <span class="pulse-dot" aria-hidden="true"></span>
            Available for work
          </span>
        </div>
        <h1>Custom internal systems for the work your team still does by hand.</h1>
        <hr class="accent-rule" />
        <p class="hero-tagline">
          Automations, dashboards, intake tools, admin panels: the software that
          runs behind the scenes, built around how your team already works. And
          if a tool you can buy would do the job, I'll tell you.
        </p>
        <div class="hero-cta">
          <a href={SITE_CONFIG.bookingUrl} class="button" target="_blank" rel="noopener noreferrer"
            >Book a free discovery call<span class="sr-only"> (opens in a new tab)</span></a
          >
          <a href="#how-i-work" class="button button-secondary">See how it works</a>
        </div>
        <p class="hero-credential">
          Computer Engineer · Co-author of two machine-learning papers, including IEEE TENCON 2024
        </p>
      </div>
      <div class="hero-portrait">
        <div class="hero-img-frame">
          <Image
            src={me}
            alt="Zherish Galvin Mayordo"
            width={640}
            height={640}
            loading="eager"
          />
        </div>
      </div>
    </div>

    <ul class="proof" aria-label="Results from real projects">
      <li>
        <p class="proof-result">10+ minutes saved on every song</p>
        <p class="proof-who">
          <a href="/projects/propresenter-lyrics-formatter-2/">Solace of Christ Church</a>, for the
          volunteers who prepare Sunday lyrics
        </p>
      </li>
      <li>
        <p class="proof-result">From a 10-account cap to no cap at all</p>
        <p class="proof-who">
          <a href="/projects/tradingview-mt5-bridge/">A forex trading team</a>, after moving off
          PineConnector
        </p>
      </li>
    </ul>
  </Section>

  <Section surface="raised" title="Work your team shouldn't still be doing by hand">
    <p class="lead">
      Most of what I build starts with one of these. If a few of them sound like
      your week, that's usually a sign a system would pay for itself.
    </p>
    <div class="swaps">
      <div class="swaps-head" aria-hidden="true">
        <span>Today</span>
        <span>Once it's built</span>
      </div>
      <ul>
        {
          SITE_CONFIG.problems.map((p) => (
            <li>
              <p class="swap-today">{p.today}</p>
              <p class="swap-fixed">
                <span class="sr-only">Once it's built: </span>
                {p.fixed}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="how-i-work" title="How working together goes">
      <p class="lead">
        You'll know the full price before you commit, and you'll own everything at
        the end.
      </p>
      <ol class="ledger">
        {
          SITE_CONFIG.engagement.map((step) => (
            <li class="ledger-row">
              <p class="ledger-note">{step.when}</p>
              <h3>{step.title}</h3>
              <p class="ledger-body">{step.body}</p>
            </li>
          ))
        }
      </ol>
  </Section>

  <Section surface="raised" class="handover-section">
    <div class="split">
      <div class="split-intro">
        <h2>What you get at handover</h2>
        <p>
          Nothing important stays in my head or my accounts. Your team can run it,
          and any developer can pick it up.
        </p>
      </div>
      <dl class="split-list">
        {
          SITE_CONFIG.handover.map((item) => (
            <div>
              <dt>{item.title}</dt>
              <dd>{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <Section title="After handover">
    <ol class="ledger">
      <li class="ledger-row">
        <p class="ledger-note">The first month</p>
        <h3>Support, on me</h3>
        <div class="ledger-body">
          <p>
            If anything doesn't work the way we agreed, I fix it. Questions and
            a refresher for your team are covered too. New features are quoted
            separately as a change request.
          </p>
        </div>
      </li>
      <li class="ledger-row">
        <p class="ledger-note">Every month after, if you want it</p>
        <h3>A monthly retainer</h3>
        <div class="ledger-body" data-retainer data-usd={usd} data-php={php}>
          <p class="price">
            <span data-price aria-live="polite">From {usd}</span>
            <span class="price-per">/ month</span>
          </p>
          <noscript>
            <p class="price-alt">Clients in the Philippines: from {php} / month.</p>
          </noscript>
          <button type="button" class="currency-toggle" data-currency-toggle hidden>
            Showing USD · Switch to PHP
          </button>
          <ul class="ledger-list">
            <li>I keep watch on the system and hear about failures first</li>
            <li>Fixes when something breaks</li>
            <li>
              Up to {retainer.changeHours} hours a month of small changes. Unused
              hours don't roll over.
            </li>
          </ul>
          <p class="fine">
            The exact price depends on the size of your system and is set in
            your proposal. The retainer is optional, and you can skip it.
          </p>
        </div>
      </li>
    </ol>
  </Section>

  <Section
    surface="raised"
    title="Projects"
    link={{ href: "/projects/", label: "View all →" }}
    class="projects-section">
    <ul class="ledger">
      {
        projects.map((project) => (
          <li class="ledger-row">
            <p class="ledger-note">
              {project.data.writeupPending ? "Just handed over" : project.data.impact}
            </p>
            <h3>
              <a href={`/projects/${project.id}/`} class="row-link">{project.data.title}</a>
            </h3>
            <div class="ledger-body">
              <p>{project.data.description}</p>
              {project.data.writeupPending && project.data.impact && (
                <p class="row-impact">{project.data.impact}</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section title="Questions people ask">
    <div class="faq">
      {
        SITE_CONFIG.faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </Section>

  <Section surface="inverse" class="cta-section">
    <h2>Tell me what your team is still doing by hand</h2>
    <p>
      A free 45-minute call. You'll leave knowing whether a custom system is worth
      it for you, even if the answer is no.
    </p>
    <a href={SITE_CONFIG.bookingUrl} class="button button-accent" target="_blank" rel="noopener noreferrer"
      >Book a free discovery call<span class="sr-only"> (opens in a new tab)</span></a
    >
  </Section>

  <script>
    import { pickCurrency, type Currency } from "../lib/currency";

    const box = document.querySelector<HTMLElement>("[data-retainer]");
    const amount = box?.querySelector<HTMLElement>("[data-price]");
    const toggle = box?.querySelector<HTMLButtonElement>("[data-currency-toggle]");

    if (box && amount && toggle) {
      const KEY = "currency";
      let saved: string | null = null;
      try {
        saved = localStorage.getItem(KEY);
      } catch {}

      const show = (c: Currency) => {
        const other = c === "USD" ? "PHP" : "USD";
        amount.textContent = `From ${c === "USD" ? box.dataset.usd : box.dataset.php}`;
        toggle.textContent = `Showing ${c} · Switch to ${other}`;
        toggle.dataset.currency = c;
      };

      show(pickCurrency(saved, Intl.DateTimeFormat().resolvedOptions().timeZone));
      toggle.hidden = false;
      toggle.addEventListener("click", () => {
        const next: Currency = toggle.dataset.currency === "USD" ? "PHP" : "USD";
        show(next);
        try {
          localStorage.setItem(KEY, next);
        } catch {}
      });
    }
  </script>

  <style>
    .hero {
      display: flex;
      gap: var(--space-2xl);
      align-items: center;
      justify-content: space-between;
    }

    .hero-content {
      max-width: 720px;
      text-align: left;
    }

    .hero-status {
      display: flex;
      align-items: center;
      gap: var(--space-md);
      margin-bottom: var(--space-sm);
    }

    .hero-status :global(.hero-avatar) {
      display: none;
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      font-size: var(--text-sm);
      color: var(--text-muted);
    }

    .pulse-dot {
      position: relative;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: var(--accent);
      flex-shrink: 0;
    }

    .pulse-dot::after {
      content: "";
      position: absolute;
      inset: -5px;
      border-radius: 50%;
      background-color: var(--accent);
      opacity: 0.5;
      animation: pulse-ring 2s ease-out infinite;
    }

    @keyframes pulse-ring {
      0% {
        transform: scale(0.6);
        opacity: 0.5;
      }
      100% {
        transform: scale(1.8);
        opacity: 0;
      }
    }

    .hero-portrait {
      position: relative;
      flex-shrink: 0;
    }

    .hero-img-frame {
      width: clamp(220px, 24vw, 320px);
      height: clamp(220px, 24vw, 320px);
      border-radius: var(--border-radius-lg);
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--bg);
    }

    .hero-img-frame :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hero h1 {
      max-width: 22ch;
      margin: 0;
    }

    .hero-tagline {
      font-size: var(--text-lg);
      color: var(--text-secondary);
      margin: 0 0 var(--space-xl);
      line-height: 1.6;
      max-width: 52ch;
    }

    .hero-cta {
      display: flex;
      gap: var(--space-md);
      align-items: center;
      flex-wrap: wrap;
    }

    .hero-credential {
      color: var(--text-muted);
      font-size: var(--text-sm);
      margin: var(--space-lg) 0 0;
    }

    /* Proof strip: two ruled results under the hero */
    .proof {
      list-style: none;
      margin: var(--space-3xl) 0 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-top: 1px solid var(--border);
    }

    .proof li {
      padding: var(--space-lg) var(--space-xl) 0 0;
    }

    .proof li + li {
      padding-left: var(--space-xl);
      border-left: 1px solid var(--border);
    }

    .proof-result {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      line-height: 1.3;
      margin: 0 0 var(--space-xs);
    }

    .proof-who {
      color: var(--text-muted);
      font-size: var(--text-sm);
      margin: 0;
    }

    .lead {
      font-size: var(--text-lg);
      color: var(--text-secondary);
      line-height: 1.6;
      max-width: 60ch;
      margin: 0 0 var(--space-2xl);
    }

    /* Today → once it's built */
    .swaps ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .swaps-head,
    .swaps li {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-2xl);
    }

    .swaps-head {
      padding-bottom: var(--space-sm);
      border-bottom: 1px solid var(--border);
      font-family: var(--font-display);
      font-style: italic;
      font-size: var(--text-lg);
      color: var(--accent);
    }

    .swaps li {
      padding-block: var(--space-lg);
      border-bottom: 1px solid var(--border);
    }

    .swaps p {
      margin: 0;
      line-height: 1.6;
      max-width: 46ch;
    }

    .swap-today {
      color: var(--text-secondary);
    }

    .swap-fixed {
      font-weight: 500;
    }

    /* Ledger rows: margin note, title, detail */
    .ledger {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--border);
    }

    .ledger-row {
      display: grid;
      grid-template-columns: minmax(9rem, 1fr) minmax(0, 1.4fr) minmax(0, 2.4fr);
      gap: var(--space-xl);
      padding-block: var(--space-xl);
      border-bottom: 1px solid var(--border);
    }

    .ledger-note {
      font-family: var(--font-display);
      font-style: italic;
      font-size: var(--text-lg);
      line-height: 1.35;
      color: var(--accent);
      margin: 0;
    }

    .ledger-row h3 {
      font-size: var(--text-xl);
      margin: 0;
    }

    .ledger-body,
    .ledger-body p {
      color: var(--text-secondary);
      line-height: 1.6;
      margin: 0;
      max-width: 58ch;
    }

    .ledger-body .price {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: var(--space-sm);
      margin: 0 0 var(--space-sm);
    }

    .price [data-price] {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: 560;
      line-height: 1.1;
      color: var(--text-primary);
      font-variant-numeric: tabular-nums;
    }

    .price-per {
      color: var(--text-muted);
    }

    .ledger-body .price-alt {
      margin-bottom: var(--space-md);
    }

    .currency-toggle {
      font: inherit;
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--accent);
      background: none;
      border: 0;
      padding: 0;
      margin: 0 0 var(--space-lg);
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 0.2em;
      text-decoration-thickness: 1px;
    }

    .currency-toggle:hover {
      color: var(--accent-hover);
    }

    .ledger-list {
      display: grid;
      gap: var(--space-xs);
      margin: 0 0 var(--space-lg);
      padding-left: 1.1em;
      color: var(--text-primary);
    }

    .ledger-list li::marker {
      color: var(--accent);
    }

    .ledger-body .fine {
      font-size: var(--text-sm);
      color: var(--text-muted);
    }

    /* Handover: statement beside a ruled list */
    .split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--space-3xl);
      align-items: start;
    }

    .split-intro h2 {
      font-size: var(--text-3xl);
      margin: 0 0 var(--space-lg);
      max-width: 16ch;
    }

    .split-intro p {
      color: var(--text-secondary);
      font-size: var(--text-lg);
      line-height: 1.6;
      max-width: 40ch;
      margin: 0;
    }

    .split-list {
      margin: 0;
      border-top: 1px solid var(--border);
    }

    .split-list > div {
      padding-block: var(--space-lg);
      border-bottom: 1px solid var(--border);
    }

    .split-list dt {
      font-weight: 600;
      margin-bottom: var(--space-xs);
    }

    .split-list dd {
      margin: 0;
      color: var(--text-secondary);
      line-height: 1.6;
      max-width: 58ch;
    }

    .row-link {
      color: inherit;
      text-decoration: none;
    }

    .row-link:hover {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 0.2em;
      text-decoration-thickness: 1px;
    }

    .ledger-body .row-impact {
      margin-top: var(--space-sm);
      color: var(--text-primary);
      font-weight: 500;
    }

    /* FAQ: ruled, native disclosure */
    .faq {
      border-top: 1px solid var(--border);
      max-width: 820px;
    }

    .faq details {
      border-bottom: 1px solid var(--border);
    }

    .faq summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-lg);
      padding-block: var(--space-lg);
      font-weight: 600;
      font-size: var(--text-lg);
      cursor: pointer;
      list-style: none;
    }

    .faq summary::-webkit-details-marker {
      display: none;
    }

    /* Drawn chevron, turns on open */
    .faq summary::after {
      content: "";
      flex-shrink: 0;
      width: 0.55em;
      height: 0.55em;
      border-right: 1.5px solid var(--accent);
      border-bottom: 1.5px solid var(--accent);
      transform: translateY(-25%) rotate(45deg);
      transition: transform var(--transition);
    }

    .faq details[open] summary::after {
      transform: translateY(25%) rotate(-135deg);
    }

    .faq summary:hover {
      color: var(--accent);
    }

    .faq details p {
      margin: 0 0 var(--space-lg);
      color: var(--text-secondary);
      line-height: 1.6;
      max-width: 62ch;
    }

    @media (max-width: 900px) {
      .ledger-row {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-sm);
      }

      .split {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-xl);
      }
    }

    @media (max-width: 768px) {
      .hero {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-xl);
      }

      .hero-portrait {
        display: none;
      }

      .hero-status :global(.hero-avatar) {
        display: block;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid var(--border);
      }

      .proof {
        grid-template-columns: minmax(0, 1fr);
        margin-top: var(--space-2xl);
      }

      .proof li,
      .proof li + li {
        padding: var(--space-lg) 0;
        border-left: 0;
      }

      .proof li + li {
        border-top: 1px solid var(--border);
      }

      .swaps-head {
        display: none;
      }

      .swaps li {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-sm);
      }

      .swaps li:first-child {
        border-top: 1px solid var(--border);
      }

      .swap-fixed::before {
        content: "Once it's built: ";
        font-family: var(--font-display);
        font-style: italic;
        font-weight: 400;
        color: var(--accent);
      }

      .swap-fixed .sr-only {
        display: none;
      }
    }
  </style>
</MainLayout>
