---
import { SITE_CONFIG } from "../config";
import { Image } from "astro:assets";
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/Section.astro";
import LinkPill from "../components/LinkPill.astro";
import Icon from "../components/Icon.astro";
import me from "../assets/me.jpg";

const categoryOrder = [
  "Automation",
  "Languages",
  "Backend",
  "Databases",
  "Cloud",
  "DevOps",
];
const knownCategories = new Set(categoryOrder);
const allCategories = [
  ...categoryOrder,
  ...[...new Set(SITE_CONFIG.skills.map((s) => s.category))].filter(
    (c) => !knownCategories.has(c),
  ),
];
const groupedSkills = allCategories
  .map((cat) => ({
    category: cat,
    items: SITE_CONFIG.skills.filter((s) => s.category === cat),
  }))
  .filter((g) => g.items.length > 0);
---

<MainLayout
  title="About Me"
  description="AI Automation Specialist and Computer Engineering graduate based in the Philippines, building automations that save businesses time and cut operational costs."
>
  <Section class="about-hero-section">
    <div class="about-hero">
      <div class="profile-img-frame">
        <Image src={me} alt="Zherish Galvin Mayordo" width={320} height={320} />
      </div>
      <div class="about-hero-text">
        <span class="eyebrow">About</span>
        <h1>Zherish Galvin Mayordo</h1>
        <p class="about-bio">
          I'm an AI Automation Specialist and Computer Engineering graduate based in
          the Philippines. I build business automations that eliminate repetitive
          work, connect applications, and streamline operations. I focus on
          creating clean, maintainable, and reliable solutions that save businesses
          time, reduce costs, and scale with their growth.
        </p>
        <div class="link-pills">
          <LinkPill href={SITE_CONFIG.socials.github} icon="github" label="GitHub" external />
          <LinkPill href={SITE_CONFIG.socials.linkedin} icon="linkedin" label="LinkedIn" external />
          <LinkPill href={`mailto:${SITE_CONFIG.email}`} icon="mail" label="Email" />
          <a href={SITE_CONFIG.resumeUrl} download class="button">
            <Icon name="download" size={16} />
            Download CV
          </a>
        </div>
      </div>
    </div>
  </Section>

  <Section surface="raised" eyebrow="Skills" title="Technical Skills" class="about-section">
    <div class="skills-cloud">
      {
        groupedSkills.map((group) => (
          <div class="skill-row">
            <span class="skill-row-label">{group.category}</span>
            <span class="skill-chips">
              {group.items.map((skill) => (
                <span class:list={["skill-chip", group.category === "Automation" && "skill-chip-accent"]}>
                  {skill.name}
                </span>
              ))}
            </span>
          </div>
        ))
      }
    </div>
  </Section>

  <Section eyebrow="Career" title="Experience" class="about-section">
    <div class="row-list experience-rows">
      {
        SITE_CONFIG.experience.map((exp) => (
          <div class="row">
            <div class="row-left">
              <div class="row-title">{exp.role}</div>
              <div class="row-sub">{exp.company}</div>
              {exp.description && (
                <ul class="row-desc">
                  {exp.description.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>
            <div class="row-right">{exp.duration}</div>
          </div>
        ))
      }
    </div>
  </Section>

  <Section surface="raised" eyebrow="Education" title="Education" class="about-section">
    <div class="row-list">
      {
        SITE_CONFIG.education.map((edu) => (
          <div class="row">
            <div class="row-left">
              <div class="row-title">{edu.degree}</div>
              <div class="row-sub">{edu.institution}</div>
            </div>
            <div class="row-right">{edu.year}</div>
          </div>
        ))
      }
    </div>
  </Section>

  <Section eyebrow="Credentials" title="Certifications" class="about-section">
    <div class="row-list">
      {
        SITE_CONFIG.certifications.map((cert) => (
          <div class="row">
            <div class="row-left">
              <div class="row-title">{cert.name}</div>
              <div class="row-sub">{cert.issuer}</div>
            </div>
            <div class="row-right">
              <span class="cert-year">{cert.year}</span>
              {cert.url && (
                <a
                  href={cert.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cert-link">
                  Certificate →
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <style>
    .about-hero {
      display: flex;
      align-items: center;
      gap: var(--space-2xl);
    }

    .profile-img-frame {
      width: 10em;
      height: 10em;
      flex-shrink: 0;
      border-radius: 50%;
      overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: 0 0 0 1px var(--border);
    }

    .profile-img-frame :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .about-hero-text h1 {
      margin: 0 0 var(--space-sm);
    }

    .about-bio {
      color: var(--text-secondary);
      font-size: var(--text-base);
      margin: 0 0 var(--space-lg);
      line-height: 1.7;
      max-width: 60ch;
    }

    .link-pills {
      display: flex;
      gap: var(--space-sm);
      flex-wrap: wrap;
      align-items: center;
    }

    .skills-cloud {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
      max-width: 820px;
    }

    .skill-row {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: var(--space-md);
    }

    .skill-row-label {
      flex: 0 0 auto;
      min-width: 7rem;
      text-align: right;
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      font-weight: 600;
      white-space: nowrap;
    }

    .skill-chips {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-xs) var(--space-sm);
    }

    .skill-chip {
      display: inline-block;
      padding: 0.25rem 0.6rem;
      border: 1px solid var(--border);
      border-radius: var(--border-radius);
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--text-secondary);
      white-space: nowrap;
      transition:
        border-color var(--transition-fast),
        color var(--transition-fast);
    }

    .skill-chip:hover {
      border-color: var(--border-hover);
      color: var(--text-primary);
    }

    .skill-chip-accent {
      border-color: var(--accent);
      color: var(--text-primary);
    }

    .skill-chip-accent:hover {
      border-color: var(--accent-hover);
    }

    .row-list {
      display: flex;
      flex-direction: column;
    }

    .row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--space-lg);
      padding: var(--space-lg) 0;
      border-bottom: 1px solid var(--border);
    }

    .experience-rows .row {
      border-left: 2px solid transparent;
      padding-left: var(--space-md);
      margin-left: calc(-1 * var(--space-md) - 2px);
      transition: border-color var(--transition-fast);
    }

    .experience-rows .row:hover {
      border-left-color: var(--accent);
    }

    .row:first-child {
      padding-top: 0;
    }

    .row:last-child {
      border-bottom: none;
    }

    .row-left {
      flex: 1;
    }

    .row-title {
      font-weight: 600;
      font-size: var(--text-base);
      color: var(--text-primary);
      margin-bottom: 0.125rem;
    }

    .row-sub {
      font-style: italic;
      font-size: var(--text-sm);
      color: var(--text-secondary);
    }

    .row-desc {
      list-style: disc;
      padding-left: 1.25rem;
      margin: var(--space-sm) 0 0;
      color: var(--text-secondary);
      font-size: var(--text-sm);
      line-height: 1.6;
      max-width: 70ch;
    }

    .row-desc li {
      margin-bottom: 0.25rem;
    }

    .row-desc li:last-child {
      margin-bottom: 0;
    }

    .row-right {
      text-align: right;
      color: var(--text-muted);
      font-size: var(--text-sm);
      white-space: nowrap;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.25rem;
    }

    .cert-link {
      color: var(--accent);
      text-decoration: none;
      font-size: var(--text-sm);
      font-weight: 500;
      transition: color var(--transition-fast);
    }

    .cert-link:hover {
      color: var(--accent-hover);
    }

    @media (max-width: 768px) {
      .about-hero {
        flex-direction: column;
        text-align: center;
        align-items: center;
      }

      .about-bio {
        margin-inline: auto;
      }

      .link-pills {
        justify-content: center;
      }

      .skill-row {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-xs);
      }

      .skill-row-label {
        min-width: 0;
        text-align: left;
      }

      .row {
        flex-direction: column;
        gap: var(--space-xs);
      }

      .row-right {
        text-align: left;
        align-items: flex-start;
      }
    }
  </style>
</MainLayout>
