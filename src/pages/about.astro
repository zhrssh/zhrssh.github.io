---
import { SITE_CONFIG } from "../config";
import { Image } from "astro:assets";
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/Section.astro";
import CtaBand from "../components/CtaBand.astro";
import LinkPill from "../components/LinkPill.astro";
import Icon from "../components/Icon.astro";
import me from "../assets/me.jpg";

---

<MainLayout
  title="About · Internal Systems Developer in the Philippines"
  description="Zherish Galvin Mayordo builds custom internal systems for small teams in the Philippines and abroad, handed over with docs and training."
>
  <Section class="about-hero-section">
    <div class="about-hero">
      <div class="profile-img-frame">
        <Image src={me} alt="Zherish Galvin Mayordo" width={320} height={320} />
      </div>
      <div class="about-hero-text">
        <h1>Zherish Galvin Mayordo</h1>
        <p class="about-bio">
          Hi, I'm Zherish (Galvin or Zhe works too). I studied Computer
          Engineering because I loved factory robots. Somewhere around my thesis,
          a robot arm you teach by hand, I realized it was the automation I
          loved, not the robots.
        </p>
        <p class="about-bio">
          Now I build internal systems for small teams: the automations,
          dashboards and tools that take the hand-work out of someone's week.
          I'm based in the Philippines (GMT+8) and work with clients here and
          abroad.
        </p>
        <p class="about-bio">
          Volunteers at Solace of Christ Church use my
          <a href="/projects/propresenter-lyrics-formatter-2/">lyrics formatter</a>
          every week. For a team that builds trading algorithms for subscribers,
          I built a <a href="/projects/tradingview-mt5-bridge/">trading bridge</a>
          that runs many strategies on one account. Trading systems run on live servers, where a
          failure nobody catches costs real money. I bring the same care to yours.
        </p>
        <p class="credentials">
          {SITE_CONFIG.education[0].degree} ({SITE_CONFIG.education[0].year.replace("Completed ", "")})
          · Co-author, IEEE TENCON 2024 and Diagnostika 2024 · Certificates from{" "}
          {SITE_CONFIG.certifications.map((c, i) => (
            <>
              {i > 0 && (i === SITE_CONFIG.certifications.length - 1 ? " and " : ", ")}
              {c.url ? <a href={c.url} target="_blank" rel="noopener noreferrer">{c.issuer}</a> : c.issuer}
            </>
          ))}
        </p>
        <div class="about-actions">
          <a href={SITE_CONFIG.bookingUrl} class="button" target="_blank" rel="noopener noreferrer"
            >Book a free discovery call<span class="sr-only"> (opens in a new tab)</span></a
          >
          <div class="link-pills">
            <LinkPill href={SITE_CONFIG.socials.github} icon="github" label="GitHub" external />
            <LinkPill href={SITE_CONFIG.socials.linkedin} icon="linkedin" label="LinkedIn" external />
            <LinkPill href={`mailto:${SITE_CONFIG.email}`} icon="mail" label="Email" />
            <a href={SITE_CONFIG.resumeUrl} download class="cv-link">
              <Icon name="download" size={16} />
              Download CV
            </a>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section surface="raised" title="Experience" class="about-section">
    <div class="row-list experience-rows">
      {
        SITE_CONFIG.experience.map((exp) => (
          <div class="row">
            <div class="row-left">
              <div class="row-title">{exp.role}</div>
              <div class="row-sub">{exp.company}</div>
              {exp.description && (
                <ul class="row-desc">
                  {exp.description.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>
            <div class="row-right">{exp.duration}</div>
          </div>
        ))
      }
    </div>
  </Section>

  <CtaBand title="Want to see if I can help your team?">
    A free 45-minute call about how the work gets done today.
  </CtaBand>

  <style>
    .about-hero {
      display: flex;
      align-items: flex-start;
      gap: var(--space-2xl);
    }

    .profile-img-frame {
      width: 10em;
      height: 10em;
      flex-shrink: 0;
      border-radius: 50%;
      overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: 0 0 0 1px var(--border);
    }

    .profile-img-frame :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .about-hero-text h1 {
      margin: 0 0 var(--space-sm);
    }

    .about-bio {
      color: var(--text-secondary);
      font-size: var(--text-base);
      margin: 0 0 var(--space-lg);
      line-height: 1.7;
      max-width: 60ch;
    }

    .credentials {
      color: var(--text-muted);
      font-size: var(--text-sm);
      margin: 0 0 var(--space-lg);
      max-width: 60ch;
    }

    .about-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-md) var(--space-lg);
    }

    .link-pills {
      display: flex;
      gap: var(--space-sm);
      flex-wrap: wrap;
      align-items: center;
    }

    .cv-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
      font-size: var(--text-sm);
      font-weight: 500;
      text-decoration: none;
      padding: 0.375rem 0.25rem;
    }

    .cv-link:hover {
      color: var(--accent-hover);
      text-decoration: underline;
      text-underline-offset: 0.2em;
      text-decoration-thickness: 1px;
    }

    .row-list {
      display: flex;
      flex-direction: column;
    }

    .row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--space-lg);
      padding: var(--space-lg) 0;
      border-bottom: 1px solid var(--border);
    }

    .row:first-child {
      padding-top: 0;
    }

    .row:last-child {
      border-bottom: none;
    }

    .row-left {
      flex: 1;
    }

    .row-title {
      font-weight: 600;
      font-size: var(--text-base);
      color: var(--text-primary);
      margin-bottom: 0.125rem;
    }

    .row-sub {
      font-style: italic;
      font-size: var(--text-sm);
      color: var(--text-secondary);
    }

    .row-desc {
      list-style: disc;
      padding-left: 1.25rem;
      margin: var(--space-sm) 0 0;
      color: var(--text-secondary);
      font-size: var(--text-sm);
      line-height: 1.6;
      max-width: 70ch;
    }

    .row-desc li {
      margin-bottom: 0.25rem;
    }

    .row-desc li:last-child {
      margin-bottom: 0;
    }

    .row-right {
      text-align: right;
      color: var(--text-muted);
      font-size: var(--text-sm);
      white-space: nowrap;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.25rem;
    }

    @media (max-width: 768px) {
      .about-hero {
        flex-direction: column;
        text-align: center;
        align-items: center;
      }

      .about-bio {
        margin-inline: auto;
      }

      .credentials {
        margin-inline: auto;
      }

      .about-actions,
      .link-pills {
        justify-content: center;
      }

      .row {
        flex-direction: column;
        gap: var(--space-xs);
      }

      .row-right {
        text-align: left;
        align-items: flex-start;
      }
    }
  </style>
</MainLayout>
