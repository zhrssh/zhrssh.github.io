---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import Section from "../../components/Section.astro";
import Icon from "../../components/Icon.astro";
import { getReadingTime } from "../../utils/readingTime";

const allBlogs = await getCollection("blog");
const allTags = [...new Set(allBlogs.flatMap((p) => p.data.tags))].sort();
---

<MainLayout title="Blog">
  <Section class="page-header-section">
    <div class="page-header">
      <span class="eyebrow">Writing</span>
      <h1>Blog</h1>
      <hr class="rule" />
      <p class="page-description">
        Thoughts, ideas, experiences, and lessons learned throughout my
        professional journey.
      </p>
    </div>
  </Section>

  <div class="container">
    <section class="controls">
      <div class="search-wrapper">
        <Icon name="search" size={18} class="search-icon" />
        <input
          type="text"
          id="search-input"
          placeholder="Search posts..."
          aria-label="Search posts"
        />
      </div>
      <select id="tag-filter" aria-label="Filter by tag">
        <option value="all">All Tags</option>
        {allTags.map((tag) => <option value={tag}>{tag}</option>)}
      </select>
      <select id="sort-select" aria-label="Sort posts">
        <option value="newest">Newest First</option>
        <option value="oldest">Oldest First</option>
        <option value="title">Alphabetical</option>
      </select>
    </section>

    <ul class="blog-list" id="blog-list">
      {
        allBlogs
          .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
          .map((post) => (
            <li
              class="blog-item"
              data-tags={post.data.tags.join("|")}
              data-title={post.data.title}
              data-description={post.data.description}
              data-date={post.data.date.getTime()}>
              <a href={`/blog/${post.id}`} class="blog-link">
                <div class="blog-meta">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </time>
                  <span class="meta-dot" aria-hidden="true">•</span>
                  <span>{getReadingTime(post.body || "")} min read</span>
                  <span class="meta-dot" aria-hidden="true">•</span>
                  <span>{post.data.author}</span>
                </div>
                <h2 class="blog-title">{post.data.title}</h2>
                <p class="blog-description">{post.data.description}</p>
                <div class="blog-footer">
                  <div class="blog-tags">
                    {post.data.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                  <span class="read-more" aria-hidden="true">Read more →</span>
                </div>
              </a>
            </li>
          ))
      }
    </ul>

    <div class="empty-state" id="empty-state" hidden>
      <p>No posts match your filters.</p>
      <button type="button" id="clear-filters" class="button button-secondary"
        >Clear filters</button
      >
    </div>
  </div>

  <script>
    const searchInput = document.getElementById(
      "search-input",
    ) as HTMLInputElement;
    const tagFilter = document.getElementById(
      "tag-filter",
    ) as HTMLSelectElement;
    const sortSelect = document.getElementById(
      "sort-select",
    ) as HTMLSelectElement;
    const blogList = document.getElementById("blog-list") as HTMLUListElement;
    const emptyState = document.getElementById("empty-state") as HTMLElement;
    const clearFiltersBtn = document.getElementById(
      "clear-filters",
    ) as HTMLButtonElement;
    const blogItems = Array.from(
      document.querySelectorAll(".blog-item"),
    ) as HTMLElement[];

    function updateView() {
      const searchTerm = searchInput.value.trim().toLowerCase();
      const selectedTag = tagFilter.value;
      const sortBy = sortSelect.value;

      const filtered = blogItems.filter((item) => {
        const { title, description, tags } = item.dataset;
        const matchesSearch =
          !searchTerm ||
          [title, description, tags].some((v) =>
            v!.toLowerCase().includes(searchTerm),
          );
        const matchesTag =
          selectedTag === "all" || tags!.split("|").includes(selectedTag);
        return matchesSearch && matchesTag;
      });

      filtered.sort((a, b) => {
        if (sortBy === "newest") return +b.dataset.date! - +a.dataset.date!;
        if (sortBy === "oldest") return +a.dataset.date! - +b.dataset.date!;
        return a.dataset.title!.localeCompare(b.dataset.title!);
      });

      blogList.replaceChildren(...filtered);
      blogList.hidden = filtered.length === 0;
      emptyState.hidden = filtered.length > 0;
    }

    searchInput.addEventListener("input", updateView);
    tagFilter.addEventListener("change", updateView);
    sortSelect.addEventListener("change", updateView);
    clearFiltersBtn.addEventListener("click", () => {
      searchInput.value = "";
      tagFilter.value = "all";
      updateView();
    });
  </script>

  <style>
    .page-header h1 {
      margin: 0;
    }

    .page-description {
      color: var(--text-secondary);
      font-size: var(--text-lg);
      margin: 0;
    }

    .controls {
      margin-bottom: var(--space-2xl);
      display: flex;
      gap: var(--space-md);
      flex-wrap: wrap;
      padding: var(--space-md) var(--space-lg);
      background-color: var(--surface-raised);
      border-radius: var(--border-radius);
    }

    .search-wrapper {
      position: relative;
      flex: 1;
      min-width: 200px;
    }

    .search-wrapper :global(.search-icon) {
      position: absolute;
      left: var(--space-md);
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      pointer-events: none;
    }

    input,
    select {
      padding: 0.375rem var(--space-md);
      border: 1px solid var(--border);
      border-radius: var(--border-radius);
      background-color: var(--bg);
      color: var(--text-primary);
      font-size: var(--text-sm);
      transition: border-color var(--transition-fast);
      width: 100%;
    }

    .search-wrapper input {
      padding-left: 2.75rem;
    }

    input:focus,
    select:focus {
      outline: none;
      border-color: var(--accent);
    }

    select {
      cursor: pointer;
      min-width: 140px;
      width: auto;
    }

    .blog-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .blog-list[hidden] {
      display: none;
    }

    .blog-item {
      border-bottom: 1px solid var(--border);
    }

    .blog-item:first-child {
      border-top: 1px solid var(--border);
    }

    .blog-link {
      text-decoration: none;
      color: inherit;
      display: block;
      padding: var(--space-lg) 0;
    }

    .blog-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-sm);
      font-size: var(--text-xs);
      color: var(--text-muted);
      margin-bottom: var(--space-sm);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .meta-dot {
      color: var(--border);
    }

    .blog-title {
      margin: 0 0 var(--space-sm);
      font-size: var(--text-xl);
      line-height: 1.3;
      color: var(--text-primary);
      transition: color var(--transition-fast);
      border-bottom: 2px solid transparent;
      display: inline-block;
    }

    .blog-link:hover .blog-title,
    .blog-link:focus-visible .blog-title {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }

    .blog-description {
      color: var(--text-secondary);
      margin: 0 0 var(--space-md);
      font-size: var(--text-base);
      line-height: 1.6;
    }

    .blog-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-md);
    }

    .blog-tags {
      display: flex;
      gap: var(--space-sm);
      flex-wrap: wrap;
    }

    .blog-tags span {
      font-size: var(--text-xs);
      padding: 0.125rem 0.5rem;
      border: 1px solid var(--border);
      border-radius: var(--border-radius);
      color: var(--text-secondary);
      background-color: transparent;
    }

    .read-more {
      display: inline-block;
      color: var(--accent);
      font-size: var(--text-sm);
      font-weight: 500;
      white-space: nowrap;
      transition: color var(--transition-fast);
    }

    .blog-link:hover .read-more {
      color: var(--accent-hover);
    }

    .empty-state {
      display: none;
      text-align: center;
      padding: var(--space-3xl) var(--space-xl);
      color: var(--text-muted);
    }

    .empty-state:not([hidden]) {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-lg);
    }

    .empty-state p {
      margin: 0;
      font-size: var(--text-lg);
    }

    @media (max-width: 768px) {
      .controls {
        flex-direction: column;
      }

      select {
        width: 100%;
      }

      .blog-footer {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-md);
      }
    }
  </style>
</MainLayout>
