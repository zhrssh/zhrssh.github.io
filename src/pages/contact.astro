---
import MainLayout from '../layouts/MainLayout.astro';
import Section from '../components/Section.astro';
import LinkPill from '../components/LinkPill.astro';
import { SITE_CONFIG } from '../config';

const whatsappUrl = `https://wa.me/${SITE_CONFIG.socials.whatsapp}`;
const viberUrl = `viber://chat?number=${encodeURIComponent(SITE_CONFIG.socials.viber)}`;
---

<MainLayout
  title="Contact · Book an Automation Call"
  description="Get in touch to automate your workflows — book a call or reach out directly via email, WhatsApp, or Viber."
>
  <Section class="contact-header-section">
    <div class="contact-hero">
      <span class="eyebrow">Contact</span>
      <h1>Let's work together</h1>
      <hr class="accent-rule" />
      <p class="contact-intro">
        Got a workflow to automate? Tell me about your project
        and I'll get back to you within a day or two. Prefer to reach out directly? Use the
        channels on the right.
      </p>
    </div>
  </Section>

  <Section class="contact-body-section">
  <div class="contact-grid">
    <div class="form-column">
      <form id="contact-form" novalidate>
        <div class="field-row">
          <div class="field">
            <label for="first_name">First name</label>
            <input type="text" id="first_name" name="first_name" required autocomplete="given-name" />
          </div>
          <div class="field">
            <label for="last_name">Last name</label>
            <input type="text" id="last_name" name="last_name" required autocomplete="family-name" />
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="phone">Phone <span class="optional">(optional)</span></label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" />
          </div>
        </div>

        <div class="field">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" required />
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <!-- Honeypot spam trap - real users won't fill this in -->
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" class="honeypot" />

        <button type="submit" id="submit-btn" class="button button-accent">
          <span class="btn-label">Send message</span>
        </button>

        <p class="consent-note">
          By sending this message, you agree to our
          <a href="/privacy-policy">Privacy Policy</a>.
        </p>

        <p id="form-success" class="form-message form-success" hidden>
          Thanks — your message has been sent. I'll reply to <span id="confirm-email"></span> shortly.
        </p>
        <p id="form-error" class="form-message form-error" hidden>
          Something went wrong sending your message. Please try again, or email me directly at
          <a href={`mailto:${SITE_CONFIG.email}`}>{SITE_CONFIG.email}</a>.
        </p>
      </form>
    </div>

    <aside class="channels-column">
      <span class="eyebrow">Direct channels</span>
      <h2>Reach me directly</h2>
      <hr class="rule" />
      <p class="channels-intro">
        No form required — pick whatever's easiest for you.
      </p>
      <div class="link-pills">
        <LinkPill href={`mailto:${SITE_CONFIG.email}`} icon="mail" label="Email" />
        <LinkPill href={whatsappUrl} icon="whatsapp" label="WhatsApp" external />
        <LinkPill href={viberUrl} icon="viber" label="Viber" external />
        <LinkPill href={SITE_CONFIG.socials.github} icon="github" label="GitHub" external />
        <LinkPill href={SITE_CONFIG.socials.linkedin} icon="linkedin" label="LinkedIn" external />
      </div>

      <div class="contact-meta">
        <div class="meta-row">
          <span class="meta-label">Email</span>
          <a href={`mailto:${SITE_CONFIG.email}`} class="meta-value">{SITE_CONFIG.email}</a>
        </div>
        <div class="meta-row">
          <span class="meta-label">Phone</span>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="meta-value">{SITE_CONFIG.phone}</a>
        </div>
        <div class="meta-row">
          <span class="meta-label">Viber</span>
          <a href={viberUrl} class="meta-value">{SITE_CONFIG.socials.viber}</a>
        </div>
        <div class="meta-row">
          <span class="meta-label">Based in</span>
          <span class="meta-value">Philippines · Remote worldwide</span>
        </div>
      </div>
    </aside>
  </div>
  </Section>

  <style>
    .contact-hero {
      margin-bottom: var(--space-2xl);
    }

    .contact-hero h1 {
      margin: 0 0 0;
      color: var(--text-primary);
    }

    .contact-intro {
      font-size: var(--text-base);
      color: var(--text-secondary);
      margin: 0;
      line-height: 1.7;
      max-width: 60ch;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
      align-items: stretch;
    }

    .form-column {
      padding: var(--space-2xl);
      border: 1px solid var(--border);
      border-top: 2px solid var(--accent);
      border-radius: var(--border-radius-lg);
      background-color: var(--bg);
    }

    .field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md);
      margin-bottom: var(--space-lg);
    }

    .field {
      margin-bottom: var(--space-lg);
    }

    .field-row .field {
      margin-bottom: 0;
    }

    @media (max-width: 480px) {
      .field-row {
        grid-template-columns: 1fr;
        gap: var(--space-lg);
      }
    }

    .field label {
      display: block;
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: var(--space-xs);
    }

    .field .optional {
      font-weight: 400;
      color: var(--text-muted);
      font-size: var(--text-xs);
    }

    .field input,
    .field textarea {
      width: 100%;
      padding: 0.625rem 0.75rem;
      font-family: inherit;
      font-size: var(--text-base);
      color: var(--text-primary);
      background-color: transparent;
      border: 1px solid var(--border);
      border-radius: var(--border-radius);
      transition: border-color var(--transition-fast);
    }

    .field textarea {
      resize: vertical;
      min-height: 120px;
      line-height: 1.6;
    }

    .field input:focus,
    .field textarea:focus {
      outline: none;
      border-color: var(--accent);
    }

    .field input:focus-visible,
    .field textarea:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
      border-radius: 2px;
    }

    .honeypot {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      overflow: hidden;
      opacity: 0;
    }

    #submit-btn {
      width: 100%;
      padding: 0.75rem var(--space-lg);
      font-family: inherit;
      font-size: var(--text-base);
      font-weight: 500;
    }

    #submit-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .form-message {
      margin-top: var(--space-lg);
      padding: var(--space-md);
      border-radius: var(--border-radius);
      font-size: var(--text-sm);
      line-height: 1.6;
    }

    .form-success {
      background-color: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.4);
      color: var(--text-primary);
    }

    .form-error {
      background-color: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: var(--text-primary);
    }

    .form-error a {
      color: var(--accent);
    }

    .consent-note {
      margin-top: var(--space-md);
      font-size: var(--text-xs);
      color: var(--text-muted);
      line-height: 1.5;
    }

    .consent-note a {
      color: var(--accent);
      text-decoration: none;
    }

    .consent-note a:hover {
      color: var(--accent-hover);
      text-decoration: underline;
    }

    .channels-column {
      padding: var(--space-2xl);
      border: 1px solid var(--border);
      border-radius: var(--border-radius-lg);
      background-color: var(--bg);
    }

    .channels-column h2 {
      margin: 0 0 0;
      font-size: var(--text-xl);
    }

    .channels-intro {
      color: var(--text-secondary);
      font-size: var(--text-sm);
      margin: 0 0 var(--space-lg);
      line-height: 1.6;
    }

    .link-pills {
      display: flex;
      gap: var(--space-sm);
      flex-wrap: wrap;
      margin-bottom: var(--space-2xl);
    }

    .contact-meta {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
      padding-top: var(--space-lg);
      border-top: 1px solid var(--border);
    }

    .meta-row {
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
    }

    .meta-label {
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }

    .meta-value {
      font-size: var(--text-sm);
      color: var(--text-primary);
      text-decoration: none;
      transition: color var(--transition-fast);
    }

    a.meta-value:hover {
      color: var(--accent);
    }

    @media (max-width: 768px) {
      .contact-grid {
        grid-template-columns: 1fr;
      }

      .form-column,
      .channels-column {
        padding: var(--space-xl);
      }
    }
  </style>

  <script is:inline define:vars={{ accessKey: SITE_CONFIG.contact.formAccessKey }}>
    const form = document.getElementById("contact-form");
    const submitBtn = document.getElementById("submit-btn");
    const btnLabel = submitBtn.querySelector(".btn-label");
    const successEl = document.getElementById("form-success");
    const errorEl = document.getElementById("form-error");
    const confirmEmail = document.getElementById("confirm-email");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      successEl.hidden = true;
      errorEl.hidden = true;

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      // Honeypot: silently drop if filled
      if (payload.botcheck) {
        return;
      }

      payload.access_key = accessKey;
      delete payload.botcheck;

      submitBtn.disabled = true;
      btnLabel.textContent = "Sending…";

      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (data.success) {
          confirmEmail.textContent = payload.email;
          successEl.hidden = false;
          form.reset();
        } else {
          errorEl.hidden = false;
        }
      } catch (err) {
        errorEl.hidden = false;
      } finally {
        submitBtn.disabled = false;
        btnLabel.textContent = "Send message";
      }
    });
  </script>
</MainLayout>