---
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;

const withImpact = projects.filter((p) => p.data.impact).slice(0, 3);

type ImpactPart = { text: string; accent: boolean };

function splitImpact(text: string): ImpactPart[] {
  const match = text.match(/([₱$]?\d[\d,.]*(?:\+|%|k)?(?:\/\w+)?)/);
  if (!match || match.index === undefined) return [{ text, accent: false }];
  const start = match.index;
  const end = start + match[0].length;
  const parts: ImpactPart[] = [];
  if (start > 0) parts.push({ text: text.slice(0, start), accent: false });
  parts.push({ text: text.slice(start, end), accent: true });
  if (end < text.length) parts.push({ text: text.slice(end), accent: false });
  return parts;
}
---

{
  withImpact.length > 0 && (
    <div class="proof-strip">
      {withImpact.map((project) => (
        <a href={`/projects/${project.id}`} class="proof-item">
          <p class="proof-impact">
            {splitImpact(project.data.impact!).map((part) =>
              part.accent ? <span class="proof-accent">{part.text}</span> : part.text
            )}
          </p>
          <span class="proof-title">{project.data.title}</span>
        </a>
      ))}
    </div>
  )
}

<style>
  .proof-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-2xl);
  }

  .proof-item {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .proof-impact {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.005em;
    margin: 0 0 var(--space-sm);
    text-wrap: pretty;
  }

  .proof-accent {
    color: var(--accent);
  }

  .proof-title {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .proof-item:hover .proof-title {
    color: var(--accent);
  }
</style>
