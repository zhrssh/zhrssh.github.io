---
import { getEntry } from "astro:content";
import { SITE_CONFIG } from "../config";

const items = await Promise.all(
  SITE_CONFIG.proof.map(async (item) => {
    const project = await getEntry("projects", item.project);
    if (!project || project.data.archived) {
      throw new Error(`SITE_CONFIG.proof: project "${item.project}" is missing or archived`);
    }
    return item;
  })
);
---

<div class="proof-strip">
  {
    items.map((item) => (
      <a href={`/projects/${item.project}/`} class="proof-item">
        <p class="proof-metric">{item.metric}</p>
        <p class="proof-outcome">{item.outcome}</p>
        <span class="proof-client">{item.client}</span>
      </a>
    ))
  }
</div>

<style>
  .proof-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-2xl);
  }

  .proof-item {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .proof-metric {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--accent);
    margin: 0 0 var(--space-xs);
  }

  .proof-outcome {
    font-size: var(--text-lg);
    line-height: 1.4;
    margin: 0 0 var(--space-sm);
    text-wrap: pretty;
  }

  .proof-client {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .proof-item:hover .proof-client {
    color: var(--accent);
  }
</style>
