---
interface Props {
  surface?: "default" | "raised" | "inverse";
  title?: string;
  rule?: boolean;
  link?: { href: string; label: string };
  class?: string;
}

const { surface = "default", title, rule = true, link, class: className } = Astro.props;
---

<section class:list={["section", `section-${surface}`, className]}>
  <div class="container">
    {
      title && (
        <div class="section-header">
          {title && <h2>{title}</h2>}
          {rule && <hr class="rule" />}
          {link && (
            <a href={link.href} class="section-link">
              {link.label}
            </a>
          )}
        </div>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-3xl);
    background-color: var(--surface);
    transition: background-color var(--transition-slow);
  }

  .section-raised {
    background-color: var(--surface-raised);
  }

  /* Inverse is the closing call-to-action band */
  .section-inverse {
    background-color: var(--surface-inverse);
    color: var(--text-on-inverse);
    text-align: center;
  }

  .section-inverse :global(h2) {
    margin: 0 0 var(--space-md);
  }

  .section-inverse :global(p) {
    font-size: var(--text-lg);
    max-width: 540px;
    margin: 0 auto var(--space-xl);
    line-height: 1.6;
    opacity: 0.85;
  }

  .section-inverse :global(h1),
  .section-inverse :global(h2),
  .section-inverse :global(h3),
  .section-inverse :global(p) {
    color: var(--text-on-inverse);
  }

  .section-inverse :global(.rule) {
    border-top-color: currentColor;
    opacity: 0.2;
  }

  .section-header {
    margin-bottom: var(--space-xl);
  }

  .section-header h2 {
    margin: 0;
  }

  .section-link {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
    margin-top: var(--space-sm);
  }

  .section-link:hover {
    color: var(--accent-hover);
  }

  .section-inverse .section-link {
    color: var(--text-on-inverse);
  }

  .section-inverse .section-link:hover {
    opacity: 0.8;
  }
</style>
