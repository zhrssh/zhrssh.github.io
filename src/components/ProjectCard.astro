---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getReadingTime } from "../utils/readingTime";

interface Props {
  project: CollectionEntry<"projects">;
  variant?: "compact" | "featured";
  showMeta?: boolean;
}

const { project, variant = "featured", showMeta = false } = Astro.props;
const readingTime = showMeta ? getReadingTime(project.body || "") : 0;
---

<article class:list={["project-card", `project-card-${variant}`]}>
  <a href={`/projects/${project.id}`} class="project-link">
    {
      project.data.coverImage && (
        <div class="project-image">
          <Image
            src={project.data.coverImage}
            alt={project.data.title}
            width={1200}
            height={675}
            widths={[360, 600, 900, 1200]}
            sizes="(max-width: 768px) 100vw, 380px"
            quality={90}
            loading="lazy"
          />
        </div>
      )
    }
    <div class="project-content">
      {
        showMeta && (
          <div class="project-meta">
            <time datetime={project.data.date.toISOString()}>
              {project.data.date.toLocaleDateString("en-US", { month: "short", year: "numeric" })}
            </time>
            <span class="meta-dot">•</span>
            <span>{readingTime} min read</span>
          </div>
        )
      }
      {project.data.impact && <span class="project-impact">{project.data.impact}</span>}
      <h3>{project.data.title}</h3>
      <p>{project.data.description}</p>
      <div class="project-tags">
        {project.data.tags.slice(0, variant === "compact" ? undefined : 3).map((tag) => <span>{tag}</span>)}
      </div>
    </div>
  </a>
</article>

<style>
  .project-card {
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-top: 2px solid var(--accent);
    transition: border-color var(--transition-fast);
  }

  .project-card:hover {
    border-color: var(--border-hover);
    border-top-color: var(--accent);
  }

  .project-link {
    text-decoration: none;
    color: inherit;
    display: block;
    height: 100%;
  }

  .project-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--bg-secondary);
  }

  .project-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-content {
    padding: var(--space-lg);
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .meta-dot {
    color: var(--border);
  }

  .project-impact {
    display: block;
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-xs);
  }

  .project-content h3 {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-lg);
    line-height: 1.3;
    transition: color var(--transition-fast);
  }

  .project-card:hover .project-content h3 {
    color: var(--accent);
  }

  .project-content p {
    margin: 0 0 var(--space-md);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .project-tags {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .project-tags span {
    font-size: var(--text-xs);
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--border-radius);
    color: var(--text-secondary);
    background-color: transparent;
  }
</style>
