---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getReadingTime } from "../utils/readingTime";

interface Props {
  project: CollectionEntry<"projects">;
  variant?: "compact" | "featured";
  showMeta?: boolean;
  /** 2 when the card sits directly under the page h1 (e.g. /projects/) */
  headingLevel?: 2 | 3;
}

const { project, variant = "compact", showMeta = false, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const titleId = `project-title-${project.id}`;
const readingTime = showMeta ? getReadingTime(project.body || "") : 0;
// No cover image: the impact line, typeset, takes the image's place
const impactPanel = !project.data.coverImage && project.data.impact;
---

<article class:list={["project-card", `project-card-${variant}`]}>
  <a href={`/projects/${project.id}/`} class="project-link" aria-labelledby={titleId}>
    {
      project.data.coverImage && (
        <div class="project-image">
          <Image
            src={project.data.coverImage}
            alt={project.data.title}
            width={1200}
            height={675}
            widths={[360, 600, 900, 1200]}
            sizes={
              variant === "featured"
                ? "(max-width: 1023px) 100vw, 560px"
                : "(max-width: 768px) 100vw, 380px"
            }
            quality={90}
            loading="lazy"
          />
        </div>
      )
    }
    {impactPanel && (
      <div class="project-image project-image-text">
        <p>{project.data.impact}</p>
      </div>
    )}
    <div class="project-content">
      {
        showMeta && (
          <div class="project-meta">
            <time datetime={project.data.date.toISOString()}>
              {project.data.date.toLocaleDateString("en-US", { month: "short", year: "numeric" })}
            </time>
            {!project.data.writeupPending && (
              <>
                <span class="meta-dot">•</span>
                <span>{readingTime} min read</span>
              </>
            )}
          </div>
        )
      }
      {project.data.writeupPending && <span class="project-badge">Just handed over</span>}
      {project.data.impact && !impactPanel && <span class="project-impact">{project.data.impact}</span>}
      <Heading id={titleId} class="project-title">{project.data.title}</Heading>
      <p>{project.data.description}</p>
      {project.data.summary && <p class="project-summary">{project.data.summary}</p>}
    </div>
  </a>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    background-color: var(--bg);
    border: 1px solid var(--border);
    transition: border-color var(--transition-fast), transform var(--transition), box-shadow var(--transition);
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
    border-color: var(--border-hover);
  }

  .project-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--bg-secondary);
  }

  .project-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-content {
    flex: 1;
    padding: var(--space-lg);
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .meta-dot {
    color: var(--border);
  }

  .project-impact {
    display: block;
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: var(--space-xs);
  }

  /* Same look whether rendered as h2 or h3 (global h2 is the display serif) */
  .project-title {
    margin: 0 0 var(--space-sm);
    font-family: inherit;
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    transition: color var(--transition-fast);
  }

  .project-card:hover .project-title {
    color: var(--accent);
  }

  .project-content p {
    margin: 0 0 var(--space-md);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .project-image-text {
    display: flex;
    align-items: flex-end;
    padding: var(--space-xl);
    border-bottom: 1px solid var(--border);
  }

  .project-image-text p {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 560;
    line-height: 1.15;
    text-wrap: balance;
    color: var(--text-primary);
  }

  .project-summary {
    display: none;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-badge {
    display: inline-block;
    padding: 0.15em 0.6em;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--accent);
    border: 1px solid currentColor;
    border-radius: var(--border-radius);
    align-self: flex-start;
    margin-bottom: var(--space-sm);
  }

  /* Featured cards go side by side (image | text) on wide screens */
  @media (min-width: 1024px) {
    .project-card-featured .project-link {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }

    .project-card-featured .project-image {
      aspect-ratio: auto;
      height: 100%;
    }

    .project-card-featured .project-image-text {
      border-bottom: 0;
      border-right: 1px solid var(--border);
    }

    .project-card-featured .project-image-text p {
      font-size: var(--text-3xl);
    }

    .project-card-featured .project-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .project-card-featured .project-summary {
      display: -webkit-box;
    }
  }
</style>
