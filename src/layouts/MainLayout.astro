---
import "../styles/global.css";
import type { HTMLAttributes } from "astro/types";
import { SITE_CONFIG } from "../config";
import BaseHead from "../components/BaseHead.astro";
import Icon from "../components/Icon.astro";

interface Props extends HTMLAttributes<"html"> {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const { title, description, image, type, ...astroAttributes } = Astro.props;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
const brand = SITE_CONFIG.title.split(' ').slice(0, 2).join(' ');
const pageTitle = `${title} · ${brand}`;
---

<html lang="en" {...astroAttributes}>
  <BaseHead
    title={pageTitle}
    description={description ?? SITE_CONFIG.description}
    image={image ?? "/og-default.png"}
    type={type}
  />
  <script is:inline>
    (function() {
      const savedTheme = localStorage.getItem("theme");
      const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      const theme = savedTheme || systemTheme;
      document.documentElement.setAttribute("data-theme", theme);
      if (
        "IntersectionObserver" in window &&
        !CSS.supports("animation-timeline: view()") &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        document.documentElement.classList.add("reveal-js");
      }
    })();
  </script>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site-header">
      <nav>
        <div class="site-name">
          <a href="/">{brand}</a>
        </div>

        <div class="nav-links">
          {SITE_CONFIG.navLinks.map((link) => (
            <a href={link.href} class:list={[{ active: isActive(link.href) }]}>
              {link.label}
            </a>
          ))}
        </div>

        <div class="nav-actions">
          <a
            href={SITE_CONFIG.socials.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub">
            <Icon name="github" size={20} />
          </a>
          <a
            href={SITE_CONFIG.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn">
            <Icon name="linkedin" size={20} />
          </a>
          <button id="theme-toggle" aria-label="Toggle dark mode">
            <span id="theme-icon">
              <Icon name="sun" size={18} class="icon-sun" />
              <Icon name="moon" size={18} class="icon-moon" />
            </span>
          </button>
        </div>

        <button id="menu-toggle" aria-label="Toggle menu">
          <Icon name="menu" size={24} />
        </button>
      </nav>

      <div id="mobile-drawer">
        <div class="drawer-header">
          <a href="/" class="drawer-brand">{brand}</a>
          <button id="menu-close" aria-label="Close menu">
            <Icon name="close" size={24} />
          </button>
        </div>
        <div class="drawer-nav-links">
          {SITE_CONFIG.navLinks.map((link) => (
            <a href={link.href} class:list={[{ active: isActive(link.href) }]}>
              {link.label}
            </a>
          ))}
        </div>
        <div class="drawer-actions">
          <a href={SITE_CONFIG.socials.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={SITE_CONFIG.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </div>
      <div id="drawer-backdrop"></div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <div class="footer-brand">
          <p class="footer-name">{brand}</p>
          <p class="footer-tagline">Automating the boring. Engineering the important.</p>
        </div>
        <nav class="footer-nav">
          <a href="/">Home</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/privacy-policy">Privacy Policy</a>
        </nav>
        <div class="footer-social">
          <a href={SITE_CONFIG.socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <Icon name="github" size={20} />
          </a>
          <a href={SITE_CONFIG.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <Icon name="linkedin" size={20} />
          </a>
        </div>
      </div>
      <p class="footer-copyright">&copy; {new Date().getFullYear()} {SITE_CONFIG.title}. All rights reserved.</p>
    </footer>

    <div class="lightbox-overlay" id="lightbox" tabindex="-1" role="dialog" aria-modal="true" aria-label="Image viewer">
      <img src="" alt="" />
      <span class="lightbox-caption"></span>
    </div>

    <style>
      .site-footer {
        background-color: var(--bg);
        border-top: 1px solid var(--border);
        padding: var(--space-3xl) var(--space-xl) var(--space-xl);
        margin-top: var(--space-3xl);
      }

      .footer-content {
        max-width: var(--max-width-wide);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr auto auto;
        gap: var(--space-2xl);
        align-items: start;
        padding-bottom: var(--space-xl);
        border-bottom: 1px solid var(--border);
      }

      .footer-brand {
        text-align: left;
      }

      .footer-name {
        font-weight: 600;
        font-size: var(--text-lg);
        color: var(--text-primary);
        margin: 0 0 var(--space-xs);
      }

      .footer-tagline {
        color: var(--text-secondary);
        font-size: var(--text-sm);
        margin: 0;
      }

      .footer-nav {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
      }

      .footer-nav a {
        color: var(--text-secondary);
        text-decoration: none;
        font-size: var(--text-sm);
        transition: color var(--transition-fast);
      }

      .footer-nav a:hover {
        color: var(--accent);
      }

      .footer-social {
        display: flex;
        gap: var(--space-md);
      }

      .footer-social a {
        color: var(--text-secondary);
        transition: color var(--transition-fast);
        padding: var(--space-sm);
        border-radius: var(--border-radius);
      }

      .footer-social a:hover {
        color: var(--accent);
      }

      .footer-copyright {
        text-align: center;
        color: var(--text-muted);
        font-size: var(--text-xs);
        margin: var(--space-lg) auto 0;
        max-width: var(--max-width-wide);
      }

      @media (max-width: 768px) {
        .footer-content {
          grid-template-columns: 1fr;
          text-align: center;
          gap: var(--space-xl);
        }

        .footer-brand {
          text-align: center;
        }

        .footer-nav {
          flex-direction: row;
          justify-content: center;
          flex-wrap: wrap;
        }

        .footer-social {
          justify-content: center;
        }
      }

      .skip-link {
        position: absolute;
        top: -3rem;
        left: var(--space-md);
        z-index: 3000;
        background-color: var(--accent);
        color: var(--text-on-inverse);
        padding: 0.5rem 1rem;
        border-radius: var(--border-radius);
        text-decoration: none;
        font-weight: 600;
        font-size: var(--text-sm);
        transition: top var(--transition-fast);
      }

      .skip-link:focus {
        top: var(--space-md);
      }
    </style>

    <script>
      const themeToggle = document.getElementById("theme-toggle");
      const htmlElement = document.documentElement;
      const header = document.querySelector(".site-header");

      // Header scroll effect
      window.addEventListener("scroll", () => {
        if (window.scrollY > 10) {
          header?.classList.add("scrolled");
        } else {
          header?.classList.remove("scrolled");
        }
      });

      // Scroll reveal fallback; flag is set in the inline head script
      if (htmlElement.classList.contains("reveal-js")) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("revealed");
              revealObserver.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -10% 0px" }
        );
        document.querySelectorAll(".section > .container").forEach((el) => revealObserver.observe(el));
      }

      themeToggle?.addEventListener("click", () => {
        const currentTheme = htmlElement.getAttribute("data-theme");
        const newTheme = currentTheme === "dark" ? "light" : "dark";

        htmlElement.setAttribute("data-theme", newTheme);
        localStorage.setItem("theme", newTheme);
      });

      // Mobile menu toggle
      const menuToggle = document.getElementById("menu-toggle") as HTMLButtonElement | null;
      const menuClose = document.getElementById("menu-close");
      const mobileDrawer = document.getElementById("mobile-drawer");
      const drawerBackdrop = document.getElementById("drawer-backdrop");

      const getFocusable = (container: HTMLElement) =>
        Array.from(
          container.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])'
          )
        ).filter((el) => el.offsetParent !== null);

      const openMenu = () => {
        mobileDrawer?.classList.add("active");
        drawerBackdrop?.classList.add("active");
        document.body.style.overflow = "hidden";
        if (mobileDrawer) getFocusable(mobileDrawer)[0]?.focus();
      };

      const closeMenu = () => {
        mobileDrawer?.classList.remove("active");
        drawerBackdrop?.classList.remove("active");
        document.body.style.overflow = "";
        menuToggle?.focus();
      };

      menuToggle?.addEventListener("click", openMenu);
      menuClose?.addEventListener("click", closeMenu);
      drawerBackdrop?.addEventListener("click", closeMenu);

      // Close on escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && mobileDrawer?.classList.contains("active")) {
          closeMenu();
        }
      });

      // Trap focus inside the drawer while it is open
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Tab" || !mobileDrawer?.classList.contains("active")) return;
        const focusables = getFocusable(mobileDrawer);
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });

      // Lightbox for in-body content images
      const lightbox = document.getElementById("lightbox");
      const lightboxImg = lightbox?.querySelector("img") as HTMLImageElement | null;
      const lightboxCaption = lightbox?.querySelector(".lightbox-caption") as HTMLElement | null;
      let activeImage: HTMLImageElement | null = null;

      const closeLightbox = () => {
        if (!lightbox) return;
        lightbox.classList.remove("active");
        document.body.style.overflow = "";
        activeImage?.focus();
        activeImage = null;
      };

      const openLightbox = (img: HTMLImageElement) => {
        if (!lightbox || !lightboxImg) return;
        activeImage = img;
        lightboxImg.src = img.currentSrc || img.src;
        lightboxImg.alt = img.alt;
        if (lightboxCaption) lightboxCaption.textContent = img.alt;
        lightbox.classList.add("active");
        document.body.style.overflow = "hidden";
        lightbox.focus();
      };

      document.querySelectorAll(".post-content img").forEach((img) => {
        const el = img as HTMLImageElement;
        el.style.cursor = "zoom-in";
        el.setAttribute("tabindex", "0");
        el.setAttribute("role", "button");
        el.setAttribute("aria-label", el.alt ? `Zoom: ${el.alt}` : "Zoom image");
        el.addEventListener("click", () => openLightbox(el));
        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            openLightbox(el);
          }
        });
      });

      lightbox?.addEventListener("click", closeLightbox);

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && lightbox?.classList.contains("active")) {
          closeLightbox();
        }
      });
    </script>
  </body>
</html>
