  "narrative": {
    "northStar": "The Engineer's Ledger",
    "overview": "The site reads like a well-kept ledger: warm paper, dark ink, ruled hairlines, and a single umber ink for anything that matters. Serif headings give it the weight of a document. A geometric grotesque body keeps it technical and legible. Nothing is decorative; every line, rule and border records structure. The look carries the pitch: work that is recorded, checked and accounted for.\n\nDensity is calm and editorial. Sections band between paper and raised paper, and content is arranged in ruled rows and columns rather than boxes. Depth is almost absent: surfaces are flat, and only interactive cards lift on hover.\n\nThere is a light ledger and a dark ledger. Dark mode swaps paper for night paper and umber for a soft brass, keeping the same restraint.",
    "keyCharacteristics": [
      "Warm paper and ink, one umber accent",
      "Newsreader serif display over Space Grotesk body",
      "Hairline rules and dividers instead of boxes",
      "Barely-there corners (3–4px)",
      "Flat at rest; lift only on hover",
      "Banded sections: paper, raised paper, ink"
    ],
    "rules": [
      {
        "name": "The One Ink Rule",
        "body": "Ledger Umber is the only accent. It marks links, active states, stage labels and the occasional rule, and never fills large areas. The one exception is the accent button in the closing band.",
        "section": "colors"
      },
      {
        "name": "The Serif Speaks First Rule",
        "body": "Newsreader is reserved for H1/H2, standout statements and short marginal notes. Every paragraph and UI label is Space Grotesk.",
        "section": "typography"
      },
      {
        "name": "The Flat Ledger Rule",
        "body": "Surfaces are flat at rest. A shadow appears only in response to hover or scroll.",
        "section": "elevation"
      },
      {
        "name": "The Ruled Line Rule",
        "body": "Group content with hairline rules and whitespace before reaching for a box. A bordered card is reserved for clickable items such as projects.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** alternate section bands (paper → raised paper → paper) and end every page with the ink closing band.",
      "**Do** lay out lists of services, principles and steps as ruled rows (1px hairline top and bottom) with 3rem block padding.",
      "**Do** use the italic Newsreader marginal note in Ledger Umber for row context, like a ledger's margin note.",
      "**Do** keep the body measure at 40–65ch and secondary text in Slate Ink.",
      "**Do** theme browser surfaces from the palette: umber text selection, and a 2px umber focus outline with a 2px offset."
    ],
    "donts": [
      "**Don't** add a second accent color or gradients. Umber (brass in dark mode) is the only accent.",
      "**Don't** use corners rounder than 4px, pill shapes, or heavy drop shadows.",
      "**Don't** turn content sections into grids of same-size icon cards.",
      "**Don't** put eyebrow labels above headings. Context goes in the margin column.",
      "**Don't** set paragraphs or UI labels in the serif."
    ]
  }
}